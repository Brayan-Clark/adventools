# ============================================================
# ANDEAHA HIZAH A - Configuration Supabase
# ============================================================
# Copier ce fichier en .env et remplir les valeurs.
#
# Préfixe PUBLIC_ obligatoire : ces valeurs sont intégrées au bundle
# client lors du build (le navigateur les lit directement).
# La clé anon est publique par conception — la sécurité des données
# repose sur le Row Level Security (RLS) de Supabase.

PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-anon-key

# Clé de service pour les scripts admin / sync (NE JAMAIS exposer côté client)
# SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# ============================================================
# Lecture des playbacks hébergés sur Google Drive (facultatif)
# ============================================================
# Sans cette clé, les cantiques dont l'audio est sur Drive ne sont PAS
# lisibles dans le site : les liens de partage renvoient
# « Content-Disposition: attachment », que Chrome bloque (ERR_BLOCKED_BY_ORB).
# L'API Drive, elle, répond avec les en-têtes CORS nécessaires.
#
# Comment l'obtenir :
#   1. console.cloud.google.com → créer (ou choisir) un projet
#   2. « API et services » → Bibliothèque → activer « Google Drive API »
#   3. « Identifiants » → Créer des identifiants → Clé API
#   4. Restreindre la clé :
#        - Restrictions d'application : « Sites web », ajouter
#          https://brayan-clark.github.io/*  (et http://localhost:*/* pour le dev)
#        - Restrictions d'API : cocher uniquement « Google Drive API »
#
# La clé est publique par conception (elle part dans le bundle) : ce sont les
# restrictions ci-dessus qui empêchent son usage depuis un autre site.
# Les fichiers doivent rester partagés en « Tout utilisateur disposant du lien ».
# PUBLIC_GOOGLE_API_KEY=votre-cle-api-google
