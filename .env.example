# ============================================================
# ANDEAHA HIZAH A - Configuration Supabase
# ============================================================
# Copier ce fichier en .env et remplir les valeurs.
#
# Préfixe PUBLIC_ obligatoire : ces valeurs sont intégrées au bundle
# client lors du build (le navigateur les lit directement).
# La clé anon est publique par conception — la sécurité des données
# repose sur le Row Level Security (RLS) de Supabase.

PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-anon-key

# Clé de service pour les scripts admin / sync (NE JAMAIS exposer côté client)
# SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key
