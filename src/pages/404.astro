---
import Layout from '@/layouts/Layout.astro';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

// Page servie par GitHub Pages pour toute route inconnue. Elle sert aussi de
// table de redirection pour les anciennes URL /cantiques/<id>, qui étaient
// prérendues une par une avant que le détail ne devienne une vue de
// /cantiques/?c=<id>.
const lang: Lang = 'fr';
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
---

<Layout lang={lang} title="404">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center">
    <p class="animate-glow-pulse text-8xl">🕊️</p>
    <h1 class="mt-6 font-display text-5xl font-bold text-slate-900 dark:text-white">404</h1>
    <p class="mt-3 text-lg text-slate-500 dark:text-slate-400">{t(lang, 'not_found_title')}</p>
    <p class="mt-1 text-slate-500 dark:text-slate-400">{t(lang, 'not_found_text')}</p>
    <a href={BASE} class="btn-gold mt-10">{t(lang, 'back_home')}</a>
  </section>
</Layout>

<script>
  const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');

  // /cantiques/33 → /cantiques/?c=adventista-33
  // /cantiques/en-33 → /cantiques/?c=sda-33
  const m = location.pathname.match(/\/cantiques\/([^/]+)\/?$/);
  if (m) {
    const legacy = decodeURIComponent(m[1]);
    const id = /^\d+$/.test(legacy)
      ? `adventista-${legacy}`
      : legacy.startsWith('en-')
        ? `sda-${legacy.slice(3)}`
        : legacy;
    location.replace(`${BASE}cantiques/?c=${encodeURIComponent(id)}`);
  }
</script>
