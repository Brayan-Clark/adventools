---
import Layout from '@/layouts/Layout.astro';
import { supabase } from '@/lib/supabase';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

// Site 100% statique (GitHub Pages) : la liste des slugs est générée au build
// depuis Supabase, le contenu de la page est chargé côté client.
export async function getStaticPaths() {
  const { data } = await supabase.from('media').select('slug').eq('type', 'audio');
  return (data ?? []).map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const lang: Lang = 'fr';
---

<Layout lang={lang} title={t(lang, 'nav_audio')}>
  <!-- État de chargement -->
  <section id="detail-loading" class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="h-4 w-56 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
    <div class="mx-auto mt-8 max-w-2xl space-y-4">
      <div class="h-28 animate-pulse rounded-2xl bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="h-4 w-40 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="h-8 w-3/4 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="h-4 w-1/2 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="h-24 animate-pulse rounded-2xl bg-slate-200/70 dark:bg-night-800/70"></div>
    </div>
  </section>

  <!-- Contenu introuvable -->
  <section id="detail-notfound" class="hidden mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-6xl">🎧</p>
    <h1 class="mt-4 font-display text-3xl font-bold">{t(lang, 'not_found_title')}</h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">{t(lang, 'not_found_text')}</p>
    <a href="/" class="btn-gold mt-8">{t(lang, 'back_home')}</a>
  </section>

  <!-- Contenu rendu côté client -->
  <section id="detail-content" class="hidden mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div id="detail-body"></div>
  </section>
</Layout>

<script>
  import { supabase, getMediaBySlug, getMedia } from '@/lib/supabase';
  import { clientLang, mediaCardHtml, formatViews, formatDate } from '@/lib/client-render';
  import { t, pickTitle, pickDescription } from '@/lib/i18n';
  import type { MediaItem } from '@/lib/types';

  const lang = clientLang();
  const BASE = import.meta.env.BASE_URL ?? '/';

  // Slug extrait de l'URL (compatible base GitHub Pages : /base/type/slug)
  const slug = window.location.pathname.split('/').filter(Boolean).pop() ?? '';

  const esc = (s: unknown): string =>
    String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
    );

  function show(id: string, ok: boolean) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('hidden', !ok);
  }

  function revealAll() {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
  }

  // Marque les vues une fois par lecture (Supabase RPC, comme AudioPlayer)
  function bindViewCounter() {
    const audio = document.getElementById('audio-player') as HTMLAudioElement | null;
    const mediaId = audio?.dataset.mediaId;
    if (audio && mediaId) {
      const key = 'ah-viewed-' + mediaId;
      audio.addEventListener('play', () => {
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, '1');
        supabase.rpc('increment_views', { media_id: Number(mediaId) }).then(() => {}, () => {});
      });
    }
  }

  function bodyHtml(item: MediaItem): string {
    const title = pickTitle(item, lang);
    const chips: string[] = [];
    if (item.category) {
      chips.push(
        `<span class="chip border border-amber-500/40 bg-amber-500/10 text-amber-600 dark:text-amber-300">${lang === 'mg' ? esc(item.category.name_mg) : esc(item.category.name_fr)}</span>`
      );
    }
    (item.tags ?? []).forEach((tag) => {
      chips.push(
        `<span class="chip border border-slate-300/70 text-slate-500 dark:border-night-600 dark:text-slate-400">#${esc(tag)}</span>`
      );
    });

    const meta: string[] = [];
    if (item.speaker) {
      meta.push(`<span>${t(lang, 'speaker')} : <span class="font-medium text-slate-700 dark:text-slate-200">${esc(item.speaker)}</span></span>`);
    }
    if (item.date) {
      meta.push(`<span>${formatDate(item.date, lang)}</span>`);
    }
    meta.push(`<span>${formatViews(item.views ?? 0)} ${t(lang, 'views')}</span>`);

    const cover = item.image
      ? `<img src="${esc(item.image)}" alt="" class="h-full w-full object-cover" />`
      : `<div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-indigo-600 to-violet-600 text-white"><svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24"><path d="M9 18V6l12-3v12M9 18a3 3 0 11-6 0 3 3 0 016 0zm12-3a3 3 0 11-6 0 3 3 0 016 0z" /></svg></div>`;

    return `
      <nav class="mb-6 text-xs text-slate-400" aria-label="Fil d'ariane">
        <a href="${BASE}" class="hover:text-gold-600 dark:hover:text-gold-400">${t(lang, 'nav_home')}</a>
        <span class="mx-1">/</span>
        <a href="${BASE}audio" class="hover:text-gold-600 dark:hover:text-gold-400">${t(lang, 'nav_audio')}</a>
        <span class="mx-1">/</span>
        <span class="text-slate-600 dark:text-slate-300">${esc(title)}</span>
      </nav>

      <div class="reveal mx-auto max-w-2xl">
        <div class="flex items-center gap-4 rounded-2xl border border-slate-200/70 bg-gradient-to-r from-slate-100 to-white p-4 shadow-sm dark:border-night-700 dark:from-night-800 dark:to-night-800/60" data-audio-card>
          <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl shadow-md">
            ${cover}
            <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition group-hover:opacity-100"></div>
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate font-display text-sm font-semibold text-slate-900 dark:text-white">${esc(title)}</p>
            ${item.speaker ? `<p class="truncate text-xs text-slate-500 dark:text-slate-400">${esc(item.speaker)}</p>` : ''}
            <audio id="audio-player" class="mt-2 w-full" controls preload="none" src="${esc(item.audio_url ?? '')}" data-media-id="${item.id}">
              Votre navigateur ne supporte pas l'audio.
            </audio>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          ${chips.join('')}
        </div>

        <h1 class="mt-5 font-display text-3xl font-bold text-slate-900 dark:text-white">${esc(title)}</h1>

        <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
          ${meta.join('')}
        </div>

        <p class="mt-6 leading-relaxed text-slate-600 dark:text-slate-300">${esc(pickDescription(item, lang) || t(lang, 'no_description'))}</p>
      </div>

      <div id="related-section" class="reveal mt-14">
        <h2 class="font-display text-xl font-semibold text-slate-900 dark:text-white">${t(lang, 'related')}</h2>
        <div id="related-grid" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"></div>
      </div>`;
  }

  async function load() {
    let item: MediaItem | null = null;
    try {
      item = await getMediaBySlug(slug);
    } catch {
      item = null;
    }

    if (!item || item.type !== 'audio') {
      show('detail-loading', false);
      show('detail-content', false);
      show('detail-notfound', true);
      const nf = document.getElementById('detail-notfound');
      if (nf) {
        const h1 = nf.querySelector('h1');
        const p = nf.querySelector('p');
        const a = nf.querySelector('a');
        if (h1) h1.textContent = t(lang, 'not_found_title');
        if (p) p.textContent = t(lang, 'not_found_text');
        if (a) a.textContent = t(lang, 'back_home');
      }
      return;
    }

    show('detail-loading', false);
    show('detail-content', true);
    document.title = `${pickTitle(item, lang)} · Andeaha Hizaha`;

    const body = document.getElementById('detail-body');
    if (body) body.innerHTML = bodyHtml(item);
    bindViewCounter();

    // À découvrir aussi (même type, item courant exclu)
    const related = (await getMedia({ type: 'audio', limit: 3 }).catch(() => []))
      .filter((m) => m.slug !== slug);
    const relatedSection = document.getElementById('related-section');
    const relatedGrid = document.getElementById('related-grid');
    if (relatedGrid && related.length) {
      relatedGrid.innerHTML = related.map((m) => mediaCardHtml(m, lang)).join('');
    } else if (relatedSection) {
      relatedSection.classList.add('hidden');
    }

    revealAll();
  }

  load();
</script>
