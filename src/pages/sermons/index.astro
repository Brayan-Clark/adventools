---
import Layout from '@/layouts/Layout.astro';
import { t } from '@/lib/i18n';

// Site 100% statique (GitHub Pages) : les sermons sont chargés côté client
// depuis Supabase. Le frontmatter ne contient que la coquille statique.
const lang = 'fr';
---

<Layout lang={lang} title={t(lang, 'nav_sermons')}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="section-kicker">✦ {t(lang, 'nav_sermons')}</p>
      <h1 class="section-title mt-1 text-4xl">{t(lang, 'latest_sermons')}</h1>
      <p class="mt-3 text-slate-500 dark:text-slate-400">
        Parcourez tous les sermons vidéo enregistrés.
      </p>
    </div>

    <!-- Filtres catégories (rempli côté client) -->
    <div id="category-filters" class="reveal mt-8 flex flex-wrap gap-2">
      {Array.from({ length: 4 }).map(() => (
        <div class="h-8 w-20 animate-pulse rounded-full bg-slate-200/60 dark:bg-night-800/60"></div>
      ))}
    </div>

    <!-- Grille (remplie côté client) -->
    <div id="grid" class="reveal mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {Array.from({ length: 8 }).map(() => (
        <div class="animate-pulse overflow-hidden rounded-2xl border border-slate-200/70 bg-white shadow-sm dark:border-night-700/60 dark:bg-night-800/70">
          <div class="aspect-video bg-slate-200/60 dark:bg-night-800/60"></div>
          <div class="space-y-2 p-4">
            <div class="h-4 rounded bg-slate-200/60 dark:bg-night-800/60"></div>
            <div class="h-3 w-2/3 rounded bg-slate-200/60 dark:bg-night-800/60"></div>
          </div>
        </div>
      ))}
    </div>

    <p id="no-results" class="mt-16 hidden text-center text-slate-500 dark:text-slate-400">{t(lang, 'search_no_results')}</p>
  </section>
</Layout>

<script>
  import { getMedia, getCategories } from '@/lib/supabase';
  import { clientLang, mediaCardHtml, settle, backendDownHtml, wireBackendRetry } from '@/lib/client-render';
  import { t } from '@/lib/i18n';

  const lang = clientLang();

  // URL base (pour les liens internes sur GitHub Pages)
  const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
  const TYPE = 'sermon';
  const PAGE = 'sermons';

  const gridEl = document.getElementById('grid');
  const filtersEl = document.getElementById('category-filters');
  const noResultsEl = document.getElementById('no-results');

  function getActiveCat() {
    return new URLSearchParams(window.location.search).get('categorie') ?? '';
  }

  function chip(cat: { slug: string; name_fr: string; name_mg: string }, active: boolean) {
    const cls = active
      ? 'border-gold-500 bg-gold-500/15 font-semibold text-gold-600 dark:text-gold-400'
      : 'border-slate-300/70 text-slate-500 hover:border-gold-500/50 hover:text-gold-600 dark:border-night-600 dark:text-slate-300';
    const name = lang === 'mg' ? cat.name_mg : cat.name_fr;
    return `<a href="${BASE}${PAGE}?categorie=${cat.slug}" class="chip border transition ${cls}">${name}</a>`;
  }

  function renderFilters(categories: { slug: string; name_fr: string; name_mg: string }[], active: string) {
    if (!filtersEl) return;
    const allCls = !active
      ? 'border-gold-500 bg-gold-500/15 font-semibold text-gold-600 dark:text-gold-400'
      : 'border-slate-300/70 text-slate-500 hover:border-gold-500/50 hover:text-gold-600 dark:border-night-600 dark:text-slate-300';
    filtersEl.innerHTML =
      `<a href="${BASE}${PAGE}" class="chip border transition ${allCls}">${t(lang, 'search_all')}</a>` +
      // `active` est le slug de la catégorie : comparer, et non le passer
      // tel quel comme booléen (toute catégorie paraissait alors active).
      categories.map((c) => chip(c, c.slug === active)).join('');
  }

  async function load() {
    const active = getActiveCat();
    const [cats, media] = await Promise.all([
      settle(getCategories(), [] as Awaited<ReturnType<typeof getCategories>>),
      settle(getMedia({ type: TYPE, category: active || undefined }), [] as Awaited<ReturnType<typeof getMedia>>),
    ]);

    renderFilters(cats.data, active);

    // Base injoignable : on le dit explicitement au lieu d'afficher
    // « Aucun résultat », qui laissait croire à un contenu vide.
    if (media.failed) {
      if (gridEl) gridEl.innerHTML = `<div class="col-span-full">${backendDownHtml(lang)}</div>`;
      if (noResultsEl) noResultsEl.classList.add('hidden');
      if (gridEl) wireBackendRetry(gridEl, () => void load());
      return;
    }

    if (gridEl) gridEl.innerHTML = media.data.map((m) => mediaCardHtml(m, lang)).join('');
    if (noResultsEl) noResultsEl.classList.toggle('hidden', media.data.length > 0);
  }

  void load();
</script>
