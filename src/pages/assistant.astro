---
import Layout from '@/layouts/Layout.astro';
import AiChat from '@/components/AiChat.astro';
import { t, getLang } from '@/lib/i18n';

const lang = getLang(Astro.url, Astro.cookies);
const suggestions = [
  t(lang, 'ai_suggestion_1'),
  t(lang, 'ai_suggestion_2'),
  t(lang, 'ai_suggestion_3'),
];
---

<Layout lang={lang} title={t(lang, 'ai_title')} description={t(lang, 'ai_subtitle')}>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div class="reveal text-center">
      <p class="section-kicker">✦ {t(lang, 'ai_title')}</p>
      <h1 class="section-title mt-1 text-4xl sm:text-5xl">{t(lang, 'ai_title')}</h1>
      <p class="mx-auto mt-4 max-w-xl text-slate-500 dark:text-slate-400">{t(lang, 'ai_subtitle')}</p>
    </div>

    <!-- Info connexion -->
    <div
      class="reveal mx-auto mt-6 flex max-w-2xl items-start gap-3 rounded-2xl border border-gold-500/40 bg-gold-500/10 px-5 py-4 text-left"
    >
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-600 dark:text-gold-400" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2a5 5 0 015 5v3h1a2 2 0 012 2v8a2 2 0 01-2 2H6a2 2 0 01-2-2v-8a2 2 0 012-2h1V7a5 5 0 015-5zm-3 8h6V7a3 3 0 10-6 0v3z" />
      </svg>
      <div>
        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">
          {t(lang, 'ai_signin_title')}
        </p>
        <p class="mt-0.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
          {t(lang, 'ai_signin_text')}
        </p>
      </div>
    </div>

    <!-- Suggestions rapides -->
    <div class="reveal mt-8 flex flex-wrap justify-center gap-2">
      {suggestions.map((s) => (
        <button
          class="assistant-suggestion rounded-full border border-gold-500/40 bg-gold-500/10 px-4 py-2 text-sm font-medium text-gold-600 transition hover:bg-gold-500/20 dark:text-gold-400"
        >
          {s}
        </button>
      ))}
    </div>

    <!-- Chat intégré -->
    <div class="reveal mt-8">
      <AiChat lang={lang} embedded />
    </div>
  </section>
</Layout>

<script>
  // Connecte les suggestions externes au chat intégré
  document.querySelectorAll('.assistant-suggestion').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById('ai-input') as HTMLInputElement | null;
      const form = document.getElementById('ai-form') as HTMLFormElement | null;
      if (input && form) {
        input.value = btn.textContent ?? '';
        form.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    });
  });
</script>
