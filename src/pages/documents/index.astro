---
import Layout from '@/layouts/Layout.astro';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

// Site 100% statique (GitHub Pages) : les documents sont chargés côté client
// depuis le manifest de la branche `data` d'adventools (raw.githubusercontent),
// avec cache localStorage pour l'offline. Pas de dépendance public/docs/.

const lang: Lang = 'fr';
---

<Layout lang={lang} title={t(lang, 'nav_documents')}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="reveal text-center">
      <p class="section-kicker">✦ {t(lang, 'nav_documents')}</p>
      <h1 class="section-title mt-1 text-4xl">📚 {t(lang, 'documents_section')}</h1>
      <p class="mx-auto mt-4 max-w-xl text-slate-500 dark:text-slate-400">{t(lang, 'documents_subtitle')}</p>
    </div>

    <!-- Recherche -->
    <div class="reveal mx-auto mt-8 max-w-2xl">
      <div class="relative">
        <input
          id="doc-search"
          type="search"
          class="input-dark w-full pl-9"
          placeholder={t(lang, 'documents_search')}
          autocomplete="off"
        />
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
        </svg>
      </div>
      <p id="doc-count" class="mt-3 text-center text-sm text-slate-500 dark:text-slate-400"></p>
    </div>

    <!-- Filtres catégories -->
    <div id="doc-cats" class="reveal mt-5 flex flex-wrap justify-center gap-2"></div>

    <!-- Grille -->
    <div id="doc-grid" class="reveal mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="doc-empty" class="mt-12 hidden text-center text-slate-500 dark:text-slate-400">{t(lang, 'documents_empty')}</p>
  </section>
</Layout>

<script>
  import { t } from '@/lib/i18n';

  const lang = document.documentElement.lang as 'fr' | 'mg';
  const searchEl = document.getElementById('doc-search') as HTMLInputElement;
  const catsEl = document.getElementById('doc-cats')!;
  const grid = document.getElementById('doc-grid')!;
  const countEl = document.getElementById('doc-count')!;
  const emptyEl = document.getElementById('doc-empty')!;

  const MANIFEST_URL = 'https://raw.githubusercontent.com/Brayan-Clark/adventools/data/docs/manifest.json';
  const CACHE_KEY = 'docs-manifest-v1';
  const CACHE_TTL = 1000 * 60 * 60 * 24; // 24h

  interface DocCat { id: string; title: string; icon?: string; color?: string; bg?: string }
  interface DocItem { id: string; title: string; fileName: string; categoryId: string; url: string; size: string; isAsset?: boolean; tags?: string[] }

  let ALL: DocItem[] = [];
  let CATS: DocCat[] = [];
  let catFilter: string | null = null;
  let query = '';

  function getCache(): { data: { docs: DocItem[]; cats: DocCat[] }; ts: number } | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const entry = JSON.parse(raw);
      if (Date.now() - entry.ts > CACHE_TTL) { localStorage.removeItem(CACHE_KEY); return null; }
      return entry;
    } catch { return null; }
  }

  async function loadManifest() {
    // 1. Cache
    const cached = getCache();
    if (cached && Array.isArray(cached.data.docs)) {
      ALL = cached.data.docs;
      CATS = cached.data.cats;
      return;
    }
    // 2. Réseau
    try {
      const res = await fetch(MANIFEST_URL);
      if (res.ok) {
        const data = await res.json();
        ALL = data.documents ?? [];
        CATS = data.categories ?? [];
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify({ data: { docs: ALL, cats: CATS }, ts: Date.now() }));
        } catch { /* quota */ }
        return;
      }
    } catch { /* offline */ }
    // 3. Fallback vide
    ALL = [];
    CATS = [];
  }

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');

  const catById = (id: string) => CATS.find((c) => c.id === id);

  function catLabel(id: string): string {
    const c = catById(id);
    return c?.title ?? id.replace(/_/g, ' ');
  }

  function catIcon(id: string): string {
    const c = catById(id);
    if (c?.icon === 'BookOpen') return '📖';
    if (c?.icon === 'FileText') return '📄';
    if (c?.icon === 'Users') return '👥';
    if (c?.icon === 'Heart') return '💖';
    if (c?.icon === 'Clock') return '⏰';
    if (c?.icon === 'Music') return '🎵';
    if (c?.icon === 'Globe') return '🌍';
    return '📁';
  }

  function renderCats() {
    catsEl.innerHTML = [
      `<button data-cat="" class="doc-cat chip font-semibold ${catFilter === null ? 'border-gold-500 bg-gold-500/15 text-gold-600 dark:text-gold-400' : 'border-slate-300/70 text-slate-500 dark:border-night-700/60 dark:text-slate-400'}">✦ ${t(lang, 'documents_all')}</button>`,
      ...CATS.map(
        (c) =>
          `<button data-cat="${esc(c.id)}" class="doc-cat chip font-semibold ${catFilter === c.id ? 'border-gold-500 bg-gold-500/15 text-gold-600 dark:text-gold-400' : 'border-slate-300/70 text-slate-500 dark:border-night-700/60 dark:text-slate-400'}">${catIcon(c.id)} ${esc(c.title)}</button>`
      ),
    ].join('');
  }

  function render() {
    const q = query.toLowerCase().trim();
    const visible = ALL.filter((d) => {
      if (catFilter && d.categoryId !== catFilter) return false;
      if (!q) return true;
      return (d.title + ' ' + d.fileName).toLowerCase().includes(q);
    });

    countEl.textContent = `${visible.length} ${t(lang, 'documents_count')}`;
    emptyEl.classList.toggle('hidden', visible.length > 0);

    grid.innerHTML = visible
      .map(
        (d) => `
        <a
          href="${esc(d.url)}"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-2xl border border-slate-200/70 bg-white/80 p-5 shadow-soft backdrop-blur transition hover:-translate-y-0.5 hover:border-gold-400/60 hover:shadow-lg dark:border-night-700/60 dark:bg-night-800/70"
        >
          <div class="flex items-start gap-3">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gold-500/10 text-xl">
              ${catIcon(d.categoryId)}
            </div>
            <div class="min-w-0 flex-1">
              <p class="line-clamp-2 text-sm font-semibold leading-snug text-slate-800 group-hover:text-gold-600 dark:text-slate-100 dark:group-hover:text-gold-400">${esc(d.title)}</p>
              <p class="mt-1 flex items-center gap-2 text-[11px] text-slate-400">
                <span class="truncate">${esc(catLabel(d.categoryId))}</span>
                <span>·</span>
                <span class="shrink-0">${esc(d.size ?? '')}</span>
              </p>
            </div>
          </div>
          <span class="mt-3 inline-flex w-fit items-center gap-1 rounded-full bg-gold-500/10 px-3 py-1 text-xs font-semibold text-gold-600 dark:text-gold-400">
            ${t(lang, 'documents_read')} →
          </span>
        </a>`
      )
      .join('');
  }

  searchEl?.addEventListener('input', () => {
    query = searchEl.value;
    render();
  });

  catsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-cat]') as HTMLElement | null;
    if (!btn) return;
    catFilter = btn.dataset.cat === '' ? null : (btn.dataset.cat ?? null);
    renderCats();
    render();
  });

  // Chargement
  (async () => {
    grid.innerHTML = '<div class="col-span-full h-40 animate-pulse rounded-2xl bg-slate-200/60 dark:bg-night-800/60"></div>';
    await loadManifest();
    renderCats();
    render();
  })();
</script>
