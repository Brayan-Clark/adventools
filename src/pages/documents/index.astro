---
import Layout from '@/layouts/Layout.astro';
import { t, getLang } from '@/lib/i18n';

const lang = getLang(Astro.url, Astro.cookies);

let payload = '{"docs":[],"cats":[]}';
try {
  const { getDocCategories, getDocs, formatSize } = await import('@/lib/documents');
  const categories = getDocCategories();
  const docs = getDocs();
  payload = JSON.stringify({
    docs: docs.map((d: any) => ({ ...d, sizeLabel: formatSize(d.size) })),
    cats: categories.map((c: any) => ({ ...c, sizeLabel: formatSize(c.size) })),
  });
} catch {
  // Dossier docs absent (CI, GitHub Pages) — page vide
}
---

<Layout lang={lang} title={t(lang, 'nav_documents')}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="reveal text-center">
      <p class="section-kicker">✦ {t(lang, 'nav_documents')}</p>
      <h1 class="section-title mt-1 text-4xl">📚 {t(lang, 'documents_section')}</h1>
      <p class="mx-auto mt-4 max-w-xl text-slate-500 dark:text-slate-400">{t(lang, 'documents_subtitle')}</p>
    </div>

    <!-- Recherche -->
    <div class="reveal mx-auto mt-8 max-w-2xl">
      <div class="relative">
        <input
          id="doc-search"
          type="search"
          class="input-dark w-full pl-9"
          placeholder={t(lang, 'documents_search')}
          autocomplete="off"
        />
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
        </svg>
      </div>
      <p id="doc-count" class="mt-3 text-center text-sm text-slate-500 dark:text-slate-400"></p>
    </div>

    <!-- Filtres catégories -->
    <div id="doc-cats" class="reveal mt-5 flex flex-wrap justify-center gap-2"></div>

    <!-- Grille -->
    <div id="doc-grid" class="reveal mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="doc-empty" class="mt-12 hidden text-center text-slate-500 dark:text-slate-400">{t(lang, 'documents_empty')}</p>

    <!-- Données sérialisées (réutilisées par le script ci-dessous) -->
    <script type="application/json" id="docs-payload" set:html={payload}></script>
  </section>
</Layout>

<script>
  import { t } from '@/lib/i18n';

  const lang = document.documentElement.lang as 'fr' | 'mg';
  const searchEl = document.getElementById('doc-search') as HTMLInputElement;
  const catsEl = document.getElementById('doc-cats')!;
  const grid = document.getElementById('doc-grid')!;
  const countEl = document.getElementById('doc-count')!;
  const emptyEl = document.getElementById('doc-empty')!;

  const payload = JSON.parse(document.getElementById('docs-payload')!.textContent!);
  const ALL = payload.docs;
  const CATS = payload.cats;

  const KIND_LABEL: Record<string, string> = {
    dossiers_eglise: '🏛️',
    dossiers_JA: '🌱',
    esprit_prophetie_fr: '📖',
    esprit_prophetie_mg: '📖',
    etudes_bibliques: '🔍',
    etudes_islamiques: '☪️',
    semaine_priere: '🙏',
    toriteny_special: '🎙️',
    dossier_MINENF: '🧒',
    autres: '📁',
  };

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');

  // Titre de catégorie lisible (nom de dossier → espaces)
  const catLabel = (id: string) => id.replace(/_/g, ' ');

  let catFilter: string | null = null;
  let query = '';

  function renderCats() {
    catsEl.innerHTML = [
      `<button data-cat="" class="doc-cat chip font-semibold ${catFilter === null ? 'border-gold-500 bg-gold-500/15 text-gold-600 dark:text-gold-400' : 'border-slate-300/70 text-slate-500 dark:border-night-600 dark:text-slate-300'}">${t(lang, 'documents_all')}</button>`,
      ...CATS.map(
        (c) =>
          `<button data-cat="${esc(c.id)}" class="doc-cat chip ${catFilter === c.id ? 'border-gold-500 bg-gold-500/15 font-semibold text-gold-600 dark:text-gold-400' : 'border-slate-300/70 text-slate-500 dark:border-night-600 dark:text-slate-300'}">${KIND_LABEL[c.id] ?? '📄'} ${esc(catLabel(c.id))} · ${c.count}</button>`
      ),
    ].join('');
  }

  function render() {
    const q = query.trim().toLowerCase();
    const results = ALL.filter((d: any) => {
      if (catFilter && d.category !== catFilter) return false;
      if (!q) return true;
      return (
        d.title.toLowerCase().includes(q) ||
        d.category.toLowerCase().includes(q) ||
        d.path.toLowerCase().includes(q)
      );
    });
    countEl.textContent = `${results.length} ${t(lang, 'documents_total')}`;
    emptyEl.classList.toggle('hidden', results.length > 0);

    grid.innerHTML = results
      .map(
        (d: any) => `
        <a href="/documents/${d.path.split('/').map(encodeURIComponent).join('/')}"
          class="card-hover group flex flex-col rounded-2xl border border-slate-200/70 bg-white p-4 shadow-sm dark:border-night-700/60 dark:bg-night-800/70">
          <div class="flex items-start gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-rose-500 to-red-600 text-lg text-white shadow">${KIND_LABEL[d.category] ?? '📄'}</span>
            <div class="min-w-0 flex-1">
              <p class="line-clamp-2 text-sm font-semibold leading-snug text-slate-800 group-hover:text-gold-600 dark:text-slate-100 dark:group-hover:text-gold-400">${esc(d.title)}</p>
              <p class="mt-1 flex items-center gap-2 text-[11px] text-slate-400">
                <span class="truncate">${esc(catLabel(d.category))}</span>
                <span>·</span>
                <span class="shrink-0">${d.sizeLabel}</span>
              </p>
            </div>
          </div>
          <span class="mt-3 inline-flex w-fit items-center gap-1 rounded-full bg-gold-500/10 px-3 py-1 text-xs font-semibold text-gold-600 dark:text-gold-400">
            ${t(lang, 'documents_read')} →
          </span>
        </a>`
      )
      .join('');
  }

  searchEl?.addEventListener('input', () => {
    query = searchEl.value;
    render();
  });

  catsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-cat]') as HTMLElement | null;
    if (!btn) return;
    catFilter = btn.dataset.cat === '' ? null : (btn.dataset.cat ?? null);
    renderCats();
    render();
  });

  renderCats();
  render();
</script>
