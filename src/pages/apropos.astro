---
import Layout from '@/layouts/Layout.astro';
import { t, getLang } from '@/lib/i18n';

const lang = getLang(Astro.url, Astro.cookies);
---

<Layout lang={lang} title={t(lang, 'about_title')} description={t(lang, 'about_subtitle')}>
  <!-- ==================== HERO ==================== -->
  <section class="hero-pattern relative overflow-hidden border-b border-slate-200/60 dark:border-night-700/60">
    <div class="pointer-events-none absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1465146344425-f00d5f5c8f07?auto=format&fit=crop&w=1920&q=80"
        alt=""
        class="h-full w-full object-cover opacity-10 dark:opacity-15"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#f6f3ee] dark:to-night-950" />
    </div>

    <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
      <span class="animate-fade-up chip border border-gold-500/40 bg-gold-500/10 text-gold-600 dark:text-gold-400">
        ✦ {t(lang, 'about_badge')}
      </span>
      <h1 class="animate-fade-up mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight text-slate-900 sm:text-6xl dark:text-white" style="animation-delay: 0.1s">
        Andeaha <span class="text-gradient-gold">Hizaha</span>
      </h1>
      <p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300" style="animation-delay: 0.2s">
        {t(lang, 'about_verse_quote')}
      </p>

      <!-- Verset : Jean 1:46 -->
      <blockquote class="animate-fade-up mx-auto mt-10 max-w-2xl rounded-3xl border border-gold-500/40 bg-white/70 p-6 shadow-soft backdrop-blur dark:bg-night-800/60 dark:border-gold-500/30" style="animation-delay: 0.3s">
        <p class="text-lg italic leading-relaxed text-slate-700 dark:text-slate-200">
          « {t(lang, 'about_verse_text')} »
        </p>
        <footer class="mt-3 text-sm font-semibold uppercase tracking-widest text-gold-600 dark:text-gold-400">
          {t(lang, 'about_verse_ref')}
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ==================== HISTOIRE DU NOM ==================== -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="reveal grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <p class="section-kicker">✦ {t(lang, 'about_name_kicker')}</p>
        <h2 class="section-title mt-1">{t(lang, 'about_name_title')}</h2>
        <p class="mt-5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
          {t(lang, 'about_name_text_1')}
        </p>
        <p class="mt-4 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
          {t(lang, 'about_name_text_2')}
        </p>
        <div class="mt-6 rounded-2xl border border-gold-500/40 bg-gold-500/5 p-5 dark:border-gold-500/30">
          <p class="font-display text-xl font-bold text-gold-600 dark:text-gold-400">« Andeha hizaha ! »</p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{t(lang, 'about_name_tagline')}</p>
        </div>
      </div>
      <div class="relative">
        <div class="overflow-hidden rounded-3xl border border-slate-200/70 shadow-soft dark:border-night-700/60">
          <img
            src="https://images.unsplash.com/photo-1509021436665-8f07dbf5bf1d?auto=format&fit=crop&w=1200&q=80"
            alt=""
            class="h-80 w-full object-cover md:h-[420px]"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-night-950/90 to-transparent p-6 pt-16">
            <p class="font-display text-lg font-semibold text-white">{t(lang, 'about_name_image')}</p>
            <p class="text-xs text-white/70">Jean 1:43-46</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LE FONDATEUR ==================== -->
  <section class="bg-gradient-to-b from-transparent to-gold-500/5 py-16 dark:to-gold-500/5">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="reveal grid gap-10 md:grid-cols-[300px_1fr] md:items-start">
        <!-- Carte identité -->
        <div class="rounded-3xl border border-slate-200/70 bg-white/80 p-6 text-center shadow-soft dark:border-night-700/60 dark:bg-night-800/70">
          <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-gold-500 to-gold-600 font-display text-3xl font-bold text-night-950 shadow-soft-gold">
            C
          </div>
          <p class="mt-4 font-display text-xl font-bold text-slate-900 dark:text-white">Clarco RAHERINANDRASANA</p>
          <p class="mt-1 text-xs uppercase tracking-widest text-gold-600 dark:text-gold-400">
            {t(lang, 'about_founder_role')}
          </p>
          <p class="mt-4 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            {t(lang, 'about_founder_caption')}
          </p>
        </div>

        <!-- Témoignage -->
        <div class="rounded-3xl border border-slate-200/70 bg-white/80 p-7 shadow-soft dark:border-night-700/60 dark:bg-night-800/70">
          <svg class="h-8 w-8 text-gold-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10 8v6a4 4 0 01-4 4H5a1 1 0 010-2h1a2 2 0 002-2H6a2 2 0 01-2-2V8a2 2 0 012-2h2a2 2 0 012 2zm10 0v6a4 4 0 01-4 4h-1a1 1 0 010-2h1a2 2 0 002-2h-2a2 2 0 01-2-2V8a2 2 0 012-2h2a2 2 0 012 2z" />
          </svg>
          <p class="mt-4 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
            {t(lang, 'about_founder_text_1')}
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
            {t(lang, 'about_founder_text_2')}
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
            {t(lang, 'about_founder_text_3')}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="chip border border-gold-500/40 bg-gold-500/10 font-semibold text-gold-600 dark:text-gold-400">
              {t(lang, 'about_founder_chip_1')}
            </span>
            <span class="chip border border-emerald-500/40 bg-emerald-500/10 font-semibold text-emerald-600 dark:text-emerald-300">
              {t(lang, 'about_founder_chip_2')}
            </span>
            <span class="chip border border-sky-500/40 bg-sky-500/10 font-semibold text-sky-600 dark:text-sky-300">
              {t(lang, 'about_founder_chip_3')}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== MISSION & VALEURS ==================== -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="reveal text-center">
      <p class="section-kicker">✦ {t(lang, 'about_mission_kicker')}</p>
      <h2 class="section-title mt-1">{t(lang, 'about_mission_title')}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-500 dark:text-slate-400">{t(lang, 'about_mission_subtitle')}</p>
    </div>

    <div class="reveal mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { icon: 'M12 3l9 5-9 5-9-5 9-5zm-7 8.5v4.5c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5v-4.5L12 13l-7-1.5z', title: t(lang, 'about_value_1_title'), text: t(lang, 'about_value_1_text'), color: 'from-sky-500 to-blue-600' },
        { icon: 'M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2c0-.56-.12-1.1-.33-1.58M7 20H2v-2a3 3 0 015.36-1.86M7 20v-2c0-.56.12-1.1.33-1.58m0 0a5 5 0 019.34 0M15 6a3 3 0 11-6 0 3 3 0 016 0z', title: t(lang, 'about_value_2_title'), text: t(lang, 'about_value_2_text'), color: 'from-emerald-500 to-teal-600' },
        { icon: 'M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2zm7 11l.95 2.55L22.5 16.5l-2.55.95L19 20l-.95-2.55L15.5 16.5l2.55-.95L19 13z', title: t(lang, 'about_value_3_title'), text: t(lang, 'about_value_3_text'), color: 'from-amber-500 to-orange-600' },
      ].map((v) => (
        <div class="card-hover rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm dark:border-night-700/60 dark:bg-night-800/70">
          <span class={`flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br ${v.color} text-white shadow-lg`}>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d={v.icon} /></svg>
          </span>
          <h3 class="mt-4 font-display text-lg font-semibold text-slate-900 dark:text-white">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== INVITATION FINALE ==================== -->
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="reveal overflow-hidden rounded-3xl border border-gold-500/40 bg-gradient-to-b from-gold-500/10 to-transparent p-8 text-center sm:p-12 dark:border-gold-500/30 dark:from-gold-500/10">
      <p class="font-display text-3xl font-bold text-slate-900 dark:text-white">« {t(lang, 'about_final_quote')} »</p>
      <p class="mx-auto mt-4 max-w-xl text-slate-600 dark:text-slate-300">{t(lang, 'about_final_text')}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/sermons" class="btn-gold">{t(lang, 'hero_cta_sermons')}</a>
        <a href="/bible" class="btn-ghost">📖 {t(lang, 'nav_bible')}</a>
        <a href="/cantiques" class="btn-ghost">🎵 {t(lang, 'nav_cantiques')}</a>
      </div>
      <p class="mt-8 text-sm font-semibold text-gold-600 dark:text-gold-400">— {t(lang, 'about_signature')}</p>
    </div>
  </section>
</Layout>
