      subtitle: t(lang, 'pres_mode_bible'),
      versionLabel: 'live',
      refLabel: `${bibleChapter.reference} : ${v.verse}`,
      verses: [v],
    });
    flatIndex = totalPages(pres) - 1;
    persist();
    showMode('agenda');
  });

