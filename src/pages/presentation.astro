      try {
        const out = await resolveBibleRefQuery(q, version);
        if (!out) throw new Error();
        const { ref, reference, verses } = out;
        const start = ref.verseStart || 1;
        const end = ref.verseEnd === 0 ? verses.length : Math.min(ref.verseEnd, verses.length);
        const range = verses.filter((v: any) => v.verse >= start && v.verse <= end);
        result.innerHTML = `
          <div class="rounded-xl border border-sky-500/30 bg-sky-500/5 p-3 text-xs">
            <p class="font-bold text-sky-600 dark:text-sky-300">${esc(reference)} (${range.length} v)</p>
