        .filter((c) => c.content && (String(c.num).includes(q) || (c.title ?? '').toLowerCase().includes(q)))
        .slice(0, 8)
        .forEach((c) => {
          cantiqueSongs.push({
            num: c.num,
            title: c.title,
            lang: l,
            content: c.content,
