        <input id="image-file" type="file" accept="image/*" class="hidden" />
        <input id="image-caption" class="input-dark w-full rounded-xl px-4 py-2.5 text-sm" placeholder="${t(lang, 'pres_image_caption')}" />
        <p id="image-status" class="hidden text-center text-xs font-semibold text-emerald-600 dark:text-emerald-400"></p>
      </div>`;

    // Convertit un fichier local en data-URL (persistant, stocké avec la présentation)
    const fileToDataUrl = (file: File) =>
      new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result));
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });

    const addImageItem = async (url: string) => {
      if (!url) return;
      const item = {
        id: uid(),
        kind: 'image',
        title: t(lang, 'pres_add_image'),
        subtitle: t(lang, 'pres_add_image'),
        imageUrl: url,
        imageCaption: $<HTMLInputElement>('image-caption').value.trim(),
      };
      activePres()!.items.push(item);
      flatIndex = totalPages(activePres()!) - 1;
      persist();
      renderAll();
      const status = $('image-status');
      status.textContent = `✅ ${t(lang, 'pres_added')}`;
      status.classList.remove('hidden');
      $<HTMLInputElement>('image-url').value = '';
      setTimeout(() => status.classList.add('hidden'), 1800);
      openAdd('image');
    };

    $('image-add').addEventListener('click', () => {
      void addImageItem($<HTMLInputElement>('image-url').value.trim());
    });
    $('image-file-btn').addEventListener('click', () => {
      $<HTMLInputElement>('image-file').click();
    });
    $<HTMLInputElement>('image-file').addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      (e.target as HTMLInputElement).value = '';
      if (!file) return;
      try {
        const url = await fileToDataUrl(file);
        await addImageItem(url);
      } catch {
        alert('Impossible de lire le fichier image.');
      }
    });
  }

  // --- Toggle "Réglages avancés" ---
  document.getElementById('advanced-toggle')?.addEventListener('click', () => {
    const body = document.getElementById('advanced-body')!;
    const arrow = document.getElementById('advanced-arrow')!;
    body.classList.toggle('hidden');
    arrow.textContent = body.classList.contains('hidden') ? '▸' : '▾';
  });

  // --- Réglages (barre du haut, selon le mode) ---
  bgPresets.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-grad]') as HTMLElement | null;
    if (!b) return;
    const s = currentSettings();
    s.bgType = 'gradient';
    s.bgValue = b.dataset.grad!;
    persistSettings();
    renderAll();
  });
  document.querySelectorAll('[data-bg]').forEach((b) => {
    b.addEventListener('click', () => {
      const s = currentSettings();
      s.bgType = (b as HTMLElement).dataset.bg as any;
      if (s.bgType === 'image' && !s.bgValue.startsWith('http')) {
        s.bgValue = 'https://images.unsplash.com/photo-1504052434569-70ad5836ab65?auto=format&fit=crop&w=1920&q=80';
      }
      persistSettings();
      renderAll();
    });
  });
  bgValue.addEventListener('change', () => {
    currentSettings().bgValue = bgValue.value;
    persistSettings();
    renderAll();
  });
  textColor.addEventListener('input', () => {
    currentSettings().textColor = textColor.value;
    persistSettings();
    renderPreview();
  });
  textSize.addEventListener('change', () => {
    currentSettings().textSize = textSize.value as any;
    persistSettings();
    renderAll();
  });
  positionSel.addEventListener('change', () => {
    currentSettings().position = positionSel.value as any;
    persistSettings();
    renderAll();
  });
  alignment.addEventListener('change', () => {
    currentSettings().alignment = alignment.value as any;
    persistSettings();
    renderAll();
  });
  verseNumbers.addEventListener('change', () => {
    currentSettings().showVerseNumbers = verseNumbers.checked;
    persistSettings();
    renderAll();
  });
  autoAdvance.addEventListener('change', () => {
    currentSettings().autoAdvance = Math.max(0, Number(autoAdvance.value) || 0);
    persistSettings();
  });
  bgMediaType.addEventListener('change', () => {
    currentSettings().bgMediaType = bgMediaType.value as any;
    persistSettings();
    renderAll();
  });
  bgMedia.addEventListener('change', () => {
    currentSettings().bgMedia = bgMedia.value.trim();
    persistSettings();
    renderAll();
  });

  // --- Modal personnalisation d'un élément ---
  const ipPos = $<HTMLSelectElement>('ip-position');
  const ipSize = $<HTMLSelectElement>('ip-size');
  const ipColor = $<HTMLInputElement>('ip-color');
  const ipAlign = $<HTMLSelectElement>('ip-alignment');
  const ipVerse = $<HTMLInputElement>('ip-verse');
  const ipBgType = $<HTMLSelectElement>('ip-bgtype');
  const ipBgValue = $<HTMLInputElement>('ip-bg-value');
  const ipBgPresets = $('ip-bg-presets');
  ipBgPresets.innerHTML = BG_PRESETS.map(
    (p) =>
      `<button data-grad="${esc(p.value)}" class="h-8 w-8 rounded-lg border-2 border-white/40 transition hover:scale-110" style="background:${p.value}" title="${esc(p.label)}"></button>`
  ).join('');
  ipBgPresets.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-grad]') as HTMLElement | null;
    if (!b) return;
    ipBgType.value = 'gradient';
    ipBgValue.value = b.dataset.grad!;
  });
  function openItemModal(item: PresentItem, base: PresentSettings) {
    const o = item.settingsOverride ?? {};
    ipPos.value = o.position ?? base.position ?? 'center';
    ipSize.value = o.textSize ?? base.textSize ?? 'lg';
    ipColor.value = (o.textColor ?? base.textColor ?? '#ffffff').startsWith('#') ? (o.textColor ?? base.textColor ?? '#ffffff') : '#ffffff';
    ipAlign.value = o.alignment ?? base.alignment ?? 'center';
    ipVerse.checked = o.showVerseNumbers ?? base.showVerseNumbers ?? true;
    ipBgType.value = o.bgType ?? base.bgType ?? 'gradient';
    ipBgValue.value = o.bgValue ?? base.bgValue ?? '';
    const modal = $('item-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeItemModal() {
    const modal = $('item-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    customItem = null;
  }
  $('ip-cancel').addEventListener('click', closeItemModal);
  $('ip-reset').addEventListener('click', () => {
    if (customItem) {
      customItem.settingsOverride = undefined;
      persist();
      renderAll();
    }
    closeItemModal();
  });
  $('ip-apply').addEventListener('click', () => {
    if (!customItem) return;
    customItem.settingsOverride = {
      position: ipPos.value as any,
      textSize: ipSize.value as any,
      textColor: ipColor.value,
      alignment: ipAlign.value as any,
      showVerseNumbers: ipVerse.checked,
      bgType: ipBgType.value as any,
      bgValue: ipBgValue.value,
    };
    persist();
    renderAll();
    closeItemModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeItemModal();
  });

  // --- Lancer la projection (selon le mode) ---
  launchBtn.addEventListener('click', () => {
    if (mode === 'bible') {
      if (!bibleChapter || !bibleChapter.verses.length) return;
      const v = bibleChapter.verses[bibleVerseIndex];
      const live: Presentation = {
        id: 'live-bible',
        name: t(lang, 'pres_mode_bible'),
        settings: { ...(modeSettings.bible ?? DEFAULT_SETTINGS) },
        updatedAt: Date.now(),
        items: [
          {
            id: uid(),
            kind: 'bible',
            title: bibleChapter.reference,
            subtitle: t(lang, 'pres_mode_bible'),
            versionLabel: 'live',
            refLabel: `${bibleChapter.reference} : ${v.verse}`,
            perVerse: true,
            verses: [v],
          },
        ],
      };
      saveLivePres('bible', live);
      saveActive({ presId: live.id, pageIndex: 0 });
      window.open('/presentation/projector', 'ah-projector', 'popup,width=1280,height=720');
    } else if (mode === 'cantique') {
      if (!cantiqueSelected) return;
      const live: Presentation = {
        id: 'live-cantique',
        name: t(lang, 'pres_mode_cantique'),
        settings: { ...(modeSettings.cantique ?? DEFAULT_SETTINGS) },
        updatedAt: Date.now(),
        items: [
          {
            id: uid(),
            kind: 'cantique',
            title: `${cantiqueSelected.num}. ${cantiqueSelected.title}`,
            subtitle: cantiqueSelected.lang === 'mg' ? 'Fihirana' : cantiqueSelected.lang === 'fr' ? 'Cantique' : 'Hymn',
            cLang: cantiqueSelected.lang as any,
            cNum: cantiqueSelected.num,
            stanzas: cantiqueSelected.stanzas,
          },
        ],
      };
      saveLivePres('cantique', live);
      saveActive({ presId: live.id, pageIndex: cantiqueStanzaIndex });
      window.open('/presentation/projector', 'ah-projector', 'popup,width=1280,height=720');
    } else {
      const pres = activePres();
      if (!pres || !pres.items.length) return;
      saveActive({ presId: pres.id, pageIndex: flatIndex });
      window.open('/presentation/projector', 'ah-projector', 'popup,width=1280,height=720');
    }
  });

  // --- Ajout direct via paramètre (?add=…) depuis cantique/bible ---
  async function handleUrlAdd() {
    const params = new URLSearchParams(location.search);
    const add = params.get('add');
    if (!add) return;
    if (add === 'cantique' && params.get('id')) {
      const l = params.get('clang') ?? 'mg';
      const r = await fetch(`${BASE}data/cantiques_${l}.json`);
      const list = await r.json();
      const c = list.find((x: any) => x.id === params.get('id'));
      if (c && c.content) {
        const item = {
          id: uid(),
          kind: 'cantique',
          title: `${c.num}. ${c.title}`,
          subtitle: l === 'mg' ? 'Fihirana' : l === 'fr' ? 'Cantique' : 'Hymn',
          cLang: l,
          cNum: c.num,
          stanzas: splitStanzas(c.content),
        };
        activePres()!.items.push(item);
        flatIndex = totalPages(activePres()!) - 1;
        persist();
        renderAll();
      }
    } else if (add === 'doc' && params.get('url')) {
      // Lien profond : ?add=doc&url=…&title=… (URL directe, pas d'API)
      const url = params.get('url') ?? '';
      const title = params.get('title') ?? url.split('/').pop() ?? t(lang, 'pres_add_doc');
      if (url) {
        const item = {
          id: uid(),
          kind: 'doc',
          title,
          subtitle: t(lang, 'pres_add_doc'),
          docPath: url,
          docUrl: url,
        };
        activePres()!.items.push(item);
        flatIndex = totalPages(activePres()!) - 1;
        persist();
        renderAll();
      }
    } else if (add === 'bible' && params.get('book')) {
      const version = params.get('version') ?? 'MG65.SQLite3';
      const book = Number(params.get('book'));
      const chapter = Number(params.get('chapter') ?? '1');
      try {
        if (await ensureBibleDb(version)) {
          const verses = readBibleChapter(bibleDb, book, chapter);
          const bookObj = bibleBooks.find((b) => b.number === book);
          const reference = `${bookObj?.longName ?? ''} ${chapter}`;
            const item = {
              id: uid(),
              kind: 'bible',
              title: reference,
              subtitle: version,
              versionLabel: version,
              refLabel: reference,
              verses,
            };
            activePres()!.items.push(item);
            flatIndex = totalPages(activePres()!) - 1;
            persist();
            renderAll();
          }
      } catch {
        /* ignore */
      }
    }
    history.replaceState(null, '', `${BASE}presentation`);
  }

  // Synchronisation : si le projecteur (autre fenêtre) navigue, on suit
  window.addEventListener('storage', (e) => {
    if (e.key === 'ah-presentation-active') {
      const raw = e.newValue;
      if (raw) {
        try {
          const act = JSON.parse(raw);
          if (act && act.presId === activeId && typeof act.pageIndex === 'number') {
            flatIndex = act.pageIndex;
            renderAll();
          }
        } catch {
          /* ignore */
        }
      }
    }
    if (e.key === 'ah-pres-overlays') {
      overlays = loadOverlays();
      syncOverlaysForm();
    }
  });

  // Recalcule la taille de l'aperçu quand la fenêtre change
  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => renderPreview(), 120);
  });

  // --- Initialisation ---
  // Première visite : on charge la démo pour montrer toutes les possibilités
  if (!presentations.length) {
    presentations = [demoPresentation()];
    activeId = presentations[0].id;
    persist();
  }
  showTab('items');
  showMode('agenda');
  renderAll();
  // Premier rendu après le calcul du layout pour remplir correctement l'aperçu
  requestAnimationFrame(() => renderPreview());
  void handleUrlAdd();

  // --- Export / Import ZIP ---
  document.getElementById('export-zip')?.addEventListener('click', async () => {
    const btn = document.getElementById('export-zip')!;
    btn.textContent = '⏳ Exportation…';
    btn.disabled = true;
    try {
      const { downloadZip } = await import('@/lib/presentation-export');
      await downloadZip();
      btn.textContent = '✅ Exporté !';
      setTimeout(() => { btn.textContent = '📥 Exporter ZIP'; btn.disabled = false; }, 2000);
    } catch (err) {
      btn.textContent = '❌ Erreur';
      alert('Export échoué : ' + (err as Error).message);
      setTimeout(() => { btn.textContent = '📥 Exporter ZIP'; btn.disabled = false; }, 2000);
    }
  });

  document.getElementById('import-zip-btn')?.addEventListener('click', () => {
    document.getElementById('import-zip')?.click();
  });

  document.getElementById('import-zip')?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const btn = document.getElementById('import-zip-btn')!;
    btn.textContent = '⏳ Importation…';
    btn.disabled = true;
    try {
      const { importPresentationsZip } = await import('@/lib/presentation-export');
      const result = await importPresentationsZip(file);
      btn.textContent = `✅ ${result.presentations} présentation(s), ${result.files} fichier(s)`;
      setTimeout(() => {
        btn.textContent = '📤 Importer ZIP';
        btn.disabled = false;
        location.reload(); // Recharger pour afficher les présentations importées
      }, 1500);
    } catch (err) {
      btn.textContent = '❌ Erreur';
      alert('Import échoué : ' + (err as Error).message);
      setTimeout(() => { btn.textContent = '📤 Importer ZIP'; btn.disabled = false; }, 2000);
    }
    input.value = '';
  });
</script>
