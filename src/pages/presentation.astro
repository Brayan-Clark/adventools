  function renderAddDoc() {
    addPanel.innerHTML = `
      <h3 class="font-display text-sm font-semibold text-slate-900 dark:text-white">📄 ${t(lang, 'pres_add_doc')}</h3>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">${t(lang, 'pres_doc_hint')}</p>
      <div class="mt-3 flex gap-2">
        <input id="doc-search" class="input-dark w-full rounded-xl px-4 py-2.5 text-sm" placeholder="${t(lang, 'documents_search')}" />
      </div>
      <div id="doc-results" class="mt-3 grid max-h-72 grid-cols-1 gap-1.5 overflow-y-auto sm:grid-cols-2"></div>`;
    const input = $<HTMLInputElement>('doc-search');
    const results = $('doc-results');

    // Manifest des documents depuis la branche data (statique, pas d'API)
    const DOC_MANIFEST = 'https://raw.githubusercontent.com/Brayan-Clark/adventools/data/docs/manifest.json';
    const DOC_CACHE_KEY = 'docs-manifest-v1';
    let docsCache: Array<{ id: string; title: string; categoryId: string; url: string; size?: string }> | null = null;

    const loadDocs = async () => {
      if (docsCache) return docsCache;
      try {
        const cached = localStorage.getItem(DOC_CACHE_KEY);
        if (cached) {
          const entry = JSON.parse(cached);
          if (Array.isArray(entry?.data?.docs)) { docsCache = entry.data.docs; return docsCache; }
        }
        const r = await fetch(DOC_MANIFEST);
        if (!r.ok) throw new Error();
        const data = await r.json();
        docsCache = data.documents ?? [];
        try { localStorage.setItem(DOC_CACHE_KEY, JSON.stringify({ data: { docs: docsCache }, ts: Date.now() })); } catch { /* quota */ }
      } catch {
        docsCache = [];
      }
      return docsCache;
    };

    const run = async () => {
      const q = input.value.trim().toLowerCase();
      results.innerHTML = '<p class="text-center text-xs text-slate-400">…</p>';
      const docs = await loadDocs();
      const list = q
        ? docs.filter((d) => (d.title + ' ' + (d.categoryId ?? '')).toLowerCase().includes(q))
        : docs;
      results.innerHTML = '';
      if (!list.length) {
        results.innerHTML = `<p class="text-center text-xs text-slate-400">${t(lang, 'documents_empty')}</p>`;
        return;
      }
      list.slice(0, 30).forEach((d) => {
        const btn = document.createElement('button');
        btn.className = 'w-full rounded-xl border border-slate-200/70 bg-white/80 px-3 py-2 text-left text-sm transition hover:border-rose-500/60 dark:border-night-700 dark:bg-night-800/70';
        btn.innerHTML = `<span class="block truncate font-semibold text-slate-800 dark:text-slate-100">📄 ${esc(d.title)}</span>
          <span class="text-[10px] uppercase text-slate-400">${esc((d.categoryId ?? '').replace(/_/g, ' '))} · ${esc(d.size ?? '')}</span>`;
        btn.addEventListener('click', () => {
          const item = {
            id: uid(),
            kind: 'doc',
            title: d.title,
            subtitle: t(lang, 'pres_add_doc'),
            docPath: d.url,
            docUrl: d.url,
          };
          activePres()!.items.push(item);
          flatIndex = totalPages(activePres()!) - 1;
          persist();
          renderAll();
          openAdd('doc');
        });
        results.appendChild(btn);
      });
    };
    input.addEventListener('input', () => void run());
    void run();
    input.focus();
  }

