    const fillVersions = async () => {
      try {
        setBibleBase(BASE);
        if (!bibleVersions.length) bibleVersions = await loadBibleVersions();
        versionSel.innerHTML = bibleVersions
          .map((v: any) => `<option value="${esc(v.file)}">${esc(v.name)}</option>`)
          .join('');
      } catch {
        /* offline */
      }
    };
    void fillVersions();
    const resolve = async () => {
      const q = refInput.value.trim();
      const version = versionSel.value;
