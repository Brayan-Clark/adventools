---
import Layout from '@/layouts/Layout.astro';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

// Studio de présentation — trois colonnes : bibliothèque → déroulé → aperçu.
//
// L'ancienne version empilait quatre rangées de réglages minuscules au-dessus
// de trois « modes » (agenda / bible / cantique) qui dupliquaient les mêmes
// fonctions. Ici il n'y a qu'un seul modèle : on cherche à gauche, on ordonne
// au centre, on projette à droite. Les réglages sont regroupés dans un panneau
// latéral au lieu de saturer la barre d'outils.
const lang: Lang = 'fr';
---

<Layout lang={lang} title={t(lang, 'nav_presentation')}>
  <div class="mx-auto flex max-w-[1800px] flex-col gap-3 px-3 py-3 sm:px-4 lg:h-[calc(100dvh-4rem)] lg:overflow-hidden">
    <!-- ===================== BARRE SUPÉRIEURE ===================== -->
    <header class="flex shrink-0 flex-wrap items-center gap-2 rounded-2xl border border-slate-200/70 bg-white/80 px-3 py-2 shadow-soft backdrop-blur dark:border-night-700/60 dark:bg-night-800/70">
      <span class="hidden items-center gap-2 pr-1 font-display text-sm font-bold text-slate-800 sm:flex dark:text-slate-100">
        🖥️ <span class="hidden lg:inline">{t(lang, 'pres_title')}</span>
      </span>

      <select
        id="pres-select"
        class="input-dark min-w-0 max-w-[210px] flex-1 rounded-lg border border-slate-300/70 bg-white px-2.5 py-1.5 text-sm font-semibold text-slate-800 dark:border-night-600 dark:bg-night-900 dark:text-slate-100 sm:flex-none"
        aria-label={t(lang, 'pres_presentations')}
      ></select>

      <div class="flex items-center gap-1">
        <button id="pres-new" class="btn-ghost px-2 py-1.5" title={t(lang, 'pres_new')} aria-label={t(lang, 'pres_new')}>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
        </button>
        <button id="pres-dup" class="btn-ghost px-2 py-1.5" title={t(lang, 'pres_duplicate')} aria-label={t(lang, 'pres_duplicate')}>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 012-2h9" /></svg>
        </button>
        <button id="pres-rename" class="btn-ghost px-2 py-1.5" title={t(lang, 'pres_name_placeholder')} aria-label={t(lang, 'pres_name_placeholder')}>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20h4l10-10a2.8 2.8 0 10-4-4L4 16v4z" /></svg>
        </button>
        <button id="pres-del" class="btn-ghost px-2 py-1.5 hover:!border-rose-500/60 hover:!text-rose-500" title={t(lang, 'pres_delete')} aria-label={t(lang, 'pres_delete')}>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 7h14M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2" /></svg>
        </button>
      </div>

      <span class="flex-1"></span>

      <button id="demo-btn" class="btn-ghost hidden px-2.5 py-1.5 text-xs sm:inline-flex" title={t(lang, 'pres_demo_hint')}>{t(lang, 'pres_demo')}</button>
      <button id="export-zip" class="btn-ghost px-2.5 py-1.5" title={t(lang, 'pres_export_zip')} aria-label={t(lang, 'pres_export_zip')}>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" /></svg>
      </button>
      <button id="import-zip-btn" class="btn-ghost px-2.5 py-1.5" title={t(lang, 'pres_import_zip')} aria-label={t(lang, 'pres_import_zip')}>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9m0 0L8 13m4-4l4 4M4 7V5a2 2 0 012-2h12a2 2 0 012 2v2" /></svg>
      </button>
      <input id="import-zip" type="file" accept=".zip" class="hidden" />
      <button id="appearance-btn" class="btn-ghost inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs" aria-expanded="false">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.3 4.3a1 1 0 011-.8h1.4a1 1 0 011 .8l.2 1.2a6.6 6.6 0 011.5.9l1.1-.4a1 1 0 011.2.4l.7 1.2a1 1 0 01-.2 1.3l-.9.8a6.6 6.6 0 010 1.7l.9.8a1 1 0 01.2 1.3l-.7 1.2a1 1 0 01-1.2.4l-1.1-.4a6.6 6.6 0 01-1.5.9l-.2 1.2a1 1 0 01-1 .8h-1.4a1 1 0 01-1-.8l-.2-1.2a6.6 6.6 0 01-1.5-.9l-1.1.4a1 1 0 01-1.2-.4l-.7-1.2a1 1 0 01.2-1.3l.9-.8a6.6 6.6 0 010-1.7l-.9-.8a1 1 0 01-.2-1.3l.7-1.2a1 1 0 011.2-.4l1.1.4a6.6 6.6 0 011.5-.9l.2-1.2z" /><circle cx="12" cy="12" r="2.5" /></svg>
        <span class="hidden md:inline">{t(lang, 'pres_appearance')}</span>
      </button>
      <button id="launch-btn" class="btn-gold inline-flex items-center gap-1.5 px-3.5 py-1.5 text-sm font-semibold" disabled>
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7L8 5z" /></svg>
        {t(lang, 'pres_project')}
      </button>
    </header>

    <!-- ===================== CORPS ===================== -->
    <div class="grid min-h-0 flex-1 gap-3 lg:grid-cols-[minmax(260px,320px)_minmax(0,1fr)_minmax(0,1.15fr)]">
      <!-- ---------- 1. BIBLIOTHÈQUE ---------- -->
      <aside class="flex min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200/70 bg-white/80 shadow-soft backdrop-blur dark:border-night-700/60 dark:bg-night-800/70">
        <div class="grid shrink-0 grid-cols-4 gap-1 border-b border-slate-200/70 p-1.5 dark:border-night-700/50" role="tablist">
          <button data-src="hymns" role="tab" class="src-tab truncate rounded-lg px-1 py-2 text-xs font-semibold text-slate-500 transition hover:text-gold-600 dark:text-slate-300">{t(lang, 'pres_source_hymns')}</button>
          <button data-src="bible" role="tab" class="src-tab truncate rounded-lg px-1 py-2 text-xs font-semibold text-slate-500 transition hover:text-gold-600 dark:text-slate-300">{t(lang, 'pres_source_bible')}</button>
          <button data-src="docs" role="tab" class="src-tab truncate rounded-lg px-1 py-2 text-xs font-semibold text-slate-500 transition hover:text-gold-600 dark:text-slate-300">{t(lang, 'pres_source_docs')}</button>
          <button data-src="other" role="tab" class="src-tab truncate rounded-lg px-1 py-2 text-xs font-semibold text-slate-500 transition hover:text-gold-600 dark:text-slate-300">{t(lang, 'pres_source_other')}</button>
        </div>

        <!-- Barre de recherche contextuelle -->
        <div class="shrink-0 space-y-1.5 border-b border-slate-200/70 p-2 dark:border-night-700/50">
          <input
            id="src-search"
            class="input-dark w-full rounded-lg px-3 py-2 text-sm"
            placeholder={t(lang, 'pres_search_song')}
            autocomplete="off"
            enterkeyhint="search"
          />
          <div class="flex items-center gap-1.5">
            <select id="src-scope" class="input-dark min-w-0 flex-1 rounded-lg px-2 py-1.5 text-xs"></select>
            <label id="per-verse-wrap" class="hidden shrink-0 items-center gap-1 text-[11px] font-medium text-slate-500 dark:text-slate-300">
              <input id="per-verse" type="checkbox" class="h-3.5 w-3.5 accent-amber-500" checked />
              <span class="hidden xl:inline">{t(lang, 'pres_per_verse')}</span>
              <span class="xl:hidden">1 v/pg</span>
            </label>
          </div>
        </div>

        <!-- Résultats -->
        <div id="src-results" class="min-h-0 flex-1 space-y-1.5 overflow-y-auto p-2"></div>
      </aside>

      <!-- ---------- 2. DÉROULÉ ---------- -->
      <section class="flex min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200/70 bg-white/80 shadow-soft backdrop-blur dark:border-night-700/60 dark:bg-night-800/70">
        <div class="flex shrink-0 items-center gap-2 border-b border-slate-200/70 px-3 py-2.5 dark:border-night-700/50">
          <span class="text-sm font-bold text-slate-800 dark:text-slate-100">📋 {t(lang, 'pres_order')}</span>
          <span id="items-count" class="rounded-full bg-slate-200/70 px-2 text-[11px] font-bold text-slate-500 dark:bg-night-700 dark:text-slate-300"></span>
          <span class="flex-1"></span>
          <span class="hidden text-[10px] text-slate-400 xl:inline dark:text-slate-500">{t(lang, 'pres_drag_hint')}</span>
          <button id="clear-items" class="btn-ghost px-2 py-1 text-[11px] hover:!border-rose-500/60 hover:!text-rose-500">{t(lang, 'pres_clear_all')}</button>
        </div>
        <div id="items-list" class="min-h-0 flex-1 space-y-1.5 overflow-y-auto p-2"></div>
      </section>

      <!-- ---------- 3. APERÇU ---------- -->
      <section class="flex min-h-0 flex-col gap-2">
        <!-- Le conteneur est lui-même en 16/9 : sans cela l'aperçu flottait au
             milieu d'une grande zone noire vide. -->
        <div id="preview-wrap" class="relative flex aspect-video max-h-[62vh] w-full shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-slate-200/70 bg-night-950 shadow-inner dark:border-night-700/60">
          <div
            id="preview-stage"
            class="relative overflow-hidden rounded-xl text-white shadow-2xl ring-1 ring-white/10"
            style="aspect-ratio:16/9;width:800px;height:450px;background:linear-gradient(135deg,#0b1020 0%,#1e1b4b 55%,#3b0764 100%);font-size:1.6rem"
          ></div>

          <div class="pointer-events-none absolute left-3 top-3 flex max-w-[70%] flex-col gap-0.5">
            <span id="preview-title" class="truncate text-xs font-bold text-white/95 [text-shadow:0_1px_4px_rgba(0,0,0,.6)]"></span>
            <span id="preview-sub" class="truncate text-[10px] text-white/60"></span>
          </div>
          <span id="preview-page" class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-black/45 px-2.5 py-1 text-[11px] font-bold text-white/90 backdrop-blur"></span>
        </div>

        <!-- Transport -->
        <div class="flex shrink-0 items-center gap-2 rounded-2xl border border-slate-200/70 bg-white/80 px-3 py-2 shadow-soft backdrop-blur dark:border-night-700/60 dark:bg-night-800/70">
          <button id="preview-prev" class="btn-ghost px-3 py-1.5 text-sm" aria-label={t(lang, 'pres_prev')}>←</button>
          <button id="preview-next" class="btn-ghost px-3 py-1.5 text-sm" aria-label={t(lang, 'pres_next')}>→</button>
          <div id="page-strip" class="flex min-w-0 flex-1 gap-1.5 overflow-x-auto"></div>
        </div>

        <!-- Pages à venir : ce que verra l'assemblée aux prochains clics. -->
        <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-200/70 bg-white/80 shadow-soft backdrop-blur dark:border-night-700/60 dark:bg-night-800/70">
          <p class="shrink-0 border-b border-slate-200/70 px-3 py-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 dark:border-night-700/50">
            {t(lang, 'pres_up_next')}
          </p>
          <div id="up-next" class="min-h-0 flex-1 space-y-1.5 overflow-y-auto p-2"></div>
        </div>
      </section>
    </div>

    <!-- `pr-24` réserve la place du bouton flottant de l'assistant IA, qui
         recouvrait la fin de la ligne. -->
    <p class="shrink-0 overflow-hidden whitespace-nowrap pr-24 text-center text-[10px] text-slate-400 dark:text-slate-500">
      <b>{t(lang, 'pres_shortcuts')}</b> — <kbd>←</kbd> <kbd>→</kbd> {t(lang, 'pres_shortcut_nav')} ·
      <kbd>/</kbd> {t(lang, 'pres_shortcut_search')} ·
      <kbd>Ctrl</kbd>+<kbd>↵</kbd> {t(lang, 'pres_shortcut_project')} ·
      <kbd>Échap</kbd> {t(lang, 'pres_shortcut_close')}
    </p>
  </div>

  <!-- ===================== PANNEAU APPARENCE ===================== -->
  <aside id="appearance" class="fixed inset-y-0 right-0 z-[70] hidden w-full max-w-md flex-col overflow-y-auto border-l border-slate-200/70 bg-white p-5 shadow-2xl dark:border-night-700 dark:bg-night-900">
    <div class="flex items-center gap-2">
      <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">⚙️ {t(lang, 'pres_appearance')}</h2>
      <span class="flex-1"></span>
      <button id="appearance-close" class="btn-ghost px-2.5 py-1.5 text-xs" aria-label="Fermer">✕</button>
    </div>
    <p id="appearance-target" class="mt-1 text-xs text-slate-400 dark:text-slate-500"></p>

    <!-- Fond -->
    <h3 class="mt-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">{t(lang, 'pres_bg')}</h3>
    <div class="mt-2 flex gap-1">
      <button data-bg="gradient" class="bg-type chip flex-1 border border-slate-300/70 py-1.5 text-xs dark:border-night-600">🌄 {t(lang, 'pres_bg_presets')}</button>
      <button data-bg="image" class="bg-type chip flex-1 border border-slate-300/70 py-1.5 text-xs dark:border-night-600">🖼️ {t(lang, 'pres_bg_image')}</button>
      <button data-bg="solid" class="bg-type chip flex-1 border border-slate-300/70 py-1.5 text-xs dark:border-night-600">🎨 {t(lang, 'pres_bg_solid')}</button>
    </div>
    <div id="bg-presets" class="mt-2 flex flex-wrap gap-1.5"></div>
    <div class="mt-2 flex items-center gap-1.5">
      <input id="bg-value" class="input-dark min-w-0 flex-1 rounded-lg px-2.5 py-1.5 text-xs" placeholder={t(lang, 'pres_bg_url_or_color')} />
      <button id="bg-upload-btn" type="button" class="btn-ghost shrink-0 px-2.5 py-1.5 text-xs" title={t(lang, 'pres_image_local')}>📁</button>
      <input id="bg-upload" type="file" accept="image/*" class="hidden" />
      <button id="bg-clear" type="button" class="btn-ghost shrink-0 px-2.5 py-1.5 text-xs" title={t(lang, 'pres_bg_reset')}>✕</button>
    </div>

    <!-- Texte -->
    <h3 class="mt-6 text-[10px] font-bold uppercase tracking-widest text-slate-400">{t(lang, 'pres_text_color')}</h3>
    <div class="mt-2 grid grid-cols-2 gap-2">
      <label class="flex items-center justify-between gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
        {t(lang, 'pres_text_color')}
        <input id="text-color" type="color" class="h-6 w-9 cursor-pointer rounded border-0 bg-transparent" value="#ffffff" />
      </label>
      <label class="flex items-center justify-between gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
        {t(lang, 'pres_text_size')}
        <select id="text-size" class="input-dark rounded px-1 py-0.5 text-xs">
          <option value="sm">{t(lang, 'pres_size_sm')}</option>
          <option value="md">{t(lang, 'pres_size_md')}</option>
          <option value="lg">{t(lang, 'pres_size_lg')}</option>
          <option value="xl">{t(lang, 'pres_size_xl')}</option>
        </select>
      </label>
      <label class="flex items-center justify-between gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
        {t(lang, 'pres_position')}
        <select id="position" class="input-dark rounded px-1 py-0.5 text-xs">
          <option value="center">{t(lang, 'pres_pos_center')}</option>
          <option value="left">{t(lang, 'pres_pos_left')}</option>
          <option value="right">{t(lang, 'pres_pos_right')}</option>
          <option value="top">{t(lang, 'pres_pos_top')}</option>
          <option value="bottom">{t(lang, 'pres_pos_bottom')}</option>
        </select>
      </label>
      <label class="flex items-center justify-between gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
        {t(lang, 'pres_alignment')}
        <select id="alignment" class="input-dark rounded px-1 py-0.5 text-xs">
          <option value="center">{t(lang, 'pres_align_center')}</option>
          <option value="left">{t(lang, 'pres_align_left')}</option>
        </select>
      </label>
      <label class="col-span-2 flex items-center gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
        <input id="verse-numbers" type="checkbox" class="h-4 w-4 accent-amber-500" />
        {t(lang, 'pres_verse_numbers')}
      </label>
    </div>

    <!-- Média de fond + défilement auto -->
    <h3 class="mt-6 text-[10px] font-bold uppercase tracking-widest text-slate-400">{t(lang, 'pres_bg_media')}</h3>
    <div class="mt-2 flex items-center gap-1.5">
      <select id="bg-media-type" class="input-dark rounded-lg px-2 py-1.5 text-xs">
        <option value="none">{t(lang, 'pres_bg_media_none')}</option>
        <option value="image">{t(lang, 'pres_bg_media_image')}</option>
        <option value="video">{t(lang, 'pres_bg_media_video')}</option>
      </select>
      <input id="bg-media" class="input-dark min-w-0 flex-1 rounded-lg px-2.5 py-1.5 text-xs" placeholder={t(lang, 'pres_bg_media_url')} />
    </div>
    <label class="mt-2 flex items-center justify-between gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
      ⏱ {t(lang, 'pres_auto_advance')}
      <input id="auto-advance" type="number" min="0" max="600" value="0" class="input-dark w-20 rounded px-1.5 py-0.5 text-xs" />
    </label>

    <!-- Superpositions du projecteur -->
    <h3 class="mt-6 text-[10px] font-bold uppercase tracking-widest text-slate-400">✨ {t(lang, 'pres_overlays')}</h3>
    <label class="mt-2 flex items-center justify-between gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
      🕐 {t(lang, 'pres_clock_format')}
      <select id="ov-clock-format" class="input-dark rounded px-1 py-0.5 text-xs">
        <option value="hm">{t(lang, 'pres_clock_fmt_hm')}</option>
        <option value="hms">{t(lang, 'pres_clock_fmt_hms')}</option>
        <option value="hmd">{t(lang, 'pres_clock_fmt_hmd')}</option>
        <option value="full">{t(lang, 'pres_clock_fmt_full')}</option>
      </select>
    </label>
    <div class="mt-2 flex items-center gap-2 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
      <span class="flex-1">⏱ {t(lang, 'pres_timer')}</span>
      <input id="ov-timer-sec" type="number" min="0" max="7200" step="30" value="300" class="input-dark w-20 rounded px-1.5 py-0.5 text-xs" />
      <input id="ov-timer-on" type="checkbox" class="h-4 w-4 accent-amber-500" />
    </div>
    <div class="mt-2 space-y-1.5 rounded-lg border border-slate-200/70 px-2.5 py-1.5 text-xs dark:border-night-700">
      <div class="flex items-center gap-2">
        <span class="flex-1">📜 {t(lang, 'pres_ticker')}</span>
        <input id="ov-ticker-speed" type="number" min="1" max="300" value="60" class="input-dark w-16 rounded px-1.5 py-0.5 text-xs" title={t(lang, 'pres_ticker_speed')} />
        <input id="ov-ticker-on" type="checkbox" class="h-4 w-4 accent-amber-500" />
      </div>
      <input id="ov-ticker-text" class="input-dark w-full rounded px-2 py-1 text-xs" placeholder={t(lang, 'pres_ticker_text')} />
    </div>

    <div class="mt-6 flex gap-2">
      <button id="appearance-reset" class="btn-ghost flex-1 px-3 py-2 text-xs">{t(lang, 'pres_reset')}</button>
    </div>
  </aside>
  <div id="appearance-backdrop" class="fixed inset-0 z-[60] hidden bg-black/40 backdrop-blur-sm"></div>
</Layout>

<script>
  import {
    DEFAULT_SETTINGS,
    BG_PRESETS,
    uid,
    loadPresentations,
    savePresentations,
    saveActive,
    loadActive,
    totalPages,
    pageAt,
    pageHtml,
    bgMediaHtml,
    backgroundValue,
    itemPageCount,
    demoPresentation,
    loadOverlays,
    saveOverlays,
  } from '@/lib/presentation';
  import type { Presentation, PresentItem, PresentSettings, PresOverlays } from '@/lib/presentation';
  import {
    HYMNAL_COLLECTIONS,
    searchHymns,
    findSong,
    songToItem,
    bibleVersions,
    resolveReference,
    bibleToItem,
    loadDocs,
    searchDocs,
    type SourceHit,
    type DocsData,
  } from '@/lib/presentation-sources';
  import { t } from '@/lib/i18n';
  import { hydratePdfSlides, pdfPageCount } from '@/lib/doc-viewer';

  const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
  const lang = (document.documentElement.lang === 'mg' ? 'mg' : 'fr') as 'fr' | 'mg';
  const T = (k: string) => t(lang, k as any);

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const esc = (s: unknown) =>
    String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  const fileToDataUrl = (file: File) =>
    new Promise<string>((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(String(r.result));
      r.onerror = () => reject(r.error);
      r.readAsDataURL(file);
    });

  // ══════════════════════ ÉTAT ══════════════════════

  type SourceTab = 'hymns' | 'bible' | 'docs' | 'other';

  let presentations = loadPresentations();
  let activeId: string | null = null;
  let flatIndex = 0;
  let source: SourceTab = 'hymns';
  /** Élément dont on édite l'apparence ; null = réglages de la présentation. */
  let styleTarget: PresentItem | null = null;
  let projector: Window | null = null;

  function createDefault(): Presentation {
    return {
      id: uid(),
      name: T('pres_title'),
      items: [],
      settings: { ...DEFAULT_SETTINGS },
      updatedAt: Date.now(),
    };
  }

  if (!presentations.length) presentations = [demoPresentation()];
  activeId = loadActive()?.presId ?? null;
  if (!presentations.some((p) => p.id === activeId)) activeId = presentations[0].id;
  flatIndex = loadActive()?.pageIndex ?? 0;

  const pres = () => presentations.find((p) => p.id === activeId) ?? presentations[0];

  function persist() {
    const p = pres();
    if (!p) return;
    p.updatedAt = Date.now();
    savePresentations(presentations);
    saveActive({ presId: p.id, pageIndex: flatIndex });
  }

  /** Réglages visés par le panneau Apparence. */
  function targetSettings(): PresentSettings {
    if (styleTarget) {
      return { ...pres().settings, ...(styleTarget.settingsOverride ?? {}) };
    }
    return pres().settings;
  }

  function applySetting<K extends keyof PresentSettings>(key: K, value: PresentSettings[K]) {
    if (styleTarget) {
      styleTarget.settingsOverride = { ...(styleTarget.settingsOverride ?? {}), [key]: value };
    } else {
      pres().settings[key] = value;
    }
    persist();
    renderPreview();
    syncAppearance();
  }

  // ══════════════════════ BIBLIOTHÈQUE ══════════════════════

  const searchInput = $<HTMLInputElement>('src-search');
  const scopeSel = $<HTMLSelectElement>('src-scope');
  const perVerseWrap = $('per-verse-wrap');
  const perVerse = $<HTMLInputElement>('per-verse');
  const resultsEl = $('src-results');

  let docsData: DocsData | null = null;
  /** Anti-course : seule la dernière recherche lancée peut écrire le résultat. */
  let searchSeq = 0;
  let searchTimer: number | undefined;

  const PLACEHOLDERS: Record<SourceTab, string> = {
    hymns: 'pres_search_song',
    bible: 'pres_bible_ref_placeholder',
    docs: 'documents_search',
    other: 'pres_source_other',
  };

  function setResults(html: string) {
    resultsEl.innerHTML = html;
  }

  function infoBox(text: string, tone: 'info' | 'error' = 'info', retry = false) {
    const color = tone === 'error' ? 'text-rose-500 border-rose-500/40' : 'text-slate-400 border-slate-300/70 dark:border-night-600';
    return `<div class="rounded-xl border border-dashed ${color} p-4 text-center text-xs">
      ${esc(text)}
      ${retry ? `<button data-retry class="chip mt-2 border border-current px-2 py-0.5 text-[10px] font-semibold">${esc(T('pres_retry'))}</button>` : ''}
    </div>`;
  }

  function hitsHtml(hits: SourceHit[]): string {
    if (!hits.length) return infoBox(T('pres_no_hits'));
    return hits
      .map(
        (h, i) => `
      <div class="group flex items-center gap-2 rounded-xl border border-slate-200/70 bg-white px-2.5 py-2 transition hover:border-gold-500/60 dark:border-night-700 dark:bg-night-900/60">
        <button data-hit="${i}" class="min-w-0 flex-1 text-left">
          <span class="block truncate text-xs font-semibold text-slate-800 dark:text-slate-100">${esc(h.title)}</span>
          ${h.subtitle ? `<span class="block truncate text-[10px] text-slate-400">${esc(h.subtitle)}</span>` : ''}
        </button>
        ${h.badge ? `<span class="shrink-0 text-[10px] text-slate-400">${esc(h.badge)}</span>` : ''}
        <button data-hit="${i}" class="shrink-0 rounded-lg bg-gold-500/10 px-2 py-1 text-[11px] font-bold text-gold-600 transition hover:bg-gold-500/25 dark:text-gold-400" title="${esc(T('pres_add'))}">＋</button>
      </div>`
      )
      .join('');
  }

  let currentHits: SourceHit[] = [];

  function bindHits() {
    resultsEl.querySelectorAll<HTMLElement>('[data-hit]').forEach((b) =>
      b.addEventListener('click', () => {
        const hit = currentHits[Number(b.dataset.hit)];
        if (hit) addItem(hit.toItem());
      })
    );
    resultsEl.querySelector('[data-retry]')?.addEventListener('click', () => void runSearch());
  }

  async function runSearch() {
    const seq = ++searchSeq;
    const q = searchInput.value.trim();
    currentHits = [];

    if (source === 'other') {
      renderOtherPanel();
      return;
    }

    setResults(infoBox(T('pres_loading')));

    try {
      if (source === 'hymns') {
        currentHits = await searchHymns(scopeSel.value || HYMNAL_COLLECTIONS[0].id, q, 40);
      } else if (source === 'bible') {
        if (!q) {
          if (seq !== searchSeq) return;
          setResults(infoBox(T('pres_bible_mode_hint')));
          return;
        }
        const ref = await resolveReference(BASE, scopeSel.value, q);
        if (!ref) {
          if (seq !== searchSeq) return;
          setResults(infoBox(`${T('bible_search_no_results')} « ${q} »`, 'error'));
          return;
        }
        const versionName = scopeSel.options[scopeSel.selectedIndex]?.text ?? scopeSel.value;
        currentHits = [
          {
            key: 'ref',
            title: ref.reference,
            subtitle: `${versionName} · ${ref.verses.length} ${T('bible_verses_label')}`,
            badge: String(ref.verses.length),
            toItem: () => bibleToItem(ref, versionName, perVerse.checked),
          },
          ...ref.verses.map((v) => ({
            key: `v${v.verse}`,
            title: `${v.verse}. ${v.text}`,
            subtitle: undefined,
            toItem: () =>
              bibleToItem({ ...ref, verses: [v], verseStart: v.verse, verseEnd: v.verse }, versionName, true),
          })),
        ];
      } else {
        docsData = docsData ?? (await loadDocs());
        if (!docsData) {
          if (seq !== searchSeq) return;
          setResults(infoBox(T('pres_no_connection'), 'error', true));
          bindHits();
          return;
        }
        currentHits = searchDocs(docsData, q, scopeSel.value || null, 40);
      }

      if (seq !== searchSeq) return;
      setResults(hitsHtml(currentHits));
      bindHits();
    } catch {
      if (seq !== searchSeq) return;
      currentHits = [];
      setResults(infoBox(T('pres_no_connection'), 'error', true));
      bindHits();
    }
  }

  /** Onglet « Autres » : texte libre, image, vidéo, audio, écran noir. */
  function renderOtherPanel() {
    setResults(`
      <div class="space-y-3">
        <div class="space-y-1.5 rounded-xl border border-slate-200/70 p-2.5 dark:border-night-700">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">📝 ${esc(T('pres_add_text'))}</p>
          <input id="o-text-title" class="input-dark w-full rounded-lg px-2.5 py-1.5 text-xs" placeholder="${esc(T('pres_text_title'))}" />
          <textarea id="o-text-body" rows="3" class="input-dark w-full rounded-lg px-2.5 py-1.5 text-xs" placeholder="${esc(T('pres_text_body'))}"></textarea>
          <button id="o-text-add" class="btn-gold w-full px-3 py-1.5 text-xs">＋ ${esc(T('pres_add'))}</button>
        </div>

        <div class="space-y-1.5 rounded-xl border border-slate-200/70 p-2.5 dark:border-night-700">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">🖼️ ${esc(T('pres_add_image'))}</p>
          <input id="o-img-url" class="input-dark w-full rounded-lg px-2.5 py-1.5 text-xs" placeholder="${esc(T('pres_image_url'))}" />
          <input id="o-img-caption" class="input-dark w-full rounded-lg px-2.5 py-1.5 text-xs" placeholder="${esc(T('pres_image_caption'))}" />
          <div class="flex gap-1.5">
            <button id="o-img-add" class="btn-gold flex-1 px-3 py-1.5 text-xs">＋ ${esc(T('pres_add'))}</button>
            <button id="o-img-file-btn" class="btn-ghost px-2.5 py-1.5 text-xs" title="${esc(T('pres_image_local'))}">📁</button>
            <input id="o-img-file" type="file" accept="image/*" class="hidden" />
          </div>
        </div>

        <div class="space-y-1.5 rounded-xl border border-slate-200/70 p-2.5 dark:border-night-700">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">🎬 ${esc(T('pres_add_video'))}</p>
          <input id="o-video-url" class="input-dark w-full rounded-lg px-2.5 py-1.5 text-xs" placeholder="${esc(T('pres_video_url'))}" />
          <button id="o-video-add" class="btn-gold w-full px-3 py-1.5 text-xs">＋ ${esc(T('pres_add'))}</button>
        </div>

        <div class="space-y-1.5 rounded-xl border border-slate-200/70 p-2.5 dark:border-night-700">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">🎧 ${esc(T('pres_add_audio'))}</p>
          <input id="o-audio-url" class="input-dark w-full rounded-lg px-2.5 py-1.5 text-xs" placeholder="${esc(T('pres_audio_url'))}" />
          <button id="o-audio-add" class="btn-gold w-full px-3 py-1.5 text-xs">＋ ${esc(T('pres_add'))}</button>
        </div>

        <button id="o-blank-add" class="btn-ghost w-full px-3 py-2 text-xs">⬛ ${esc(T('pres_black_screen'))}</button>
      </div>`);

    const val = (id: string) => ($<HTMLInputElement>(id)?.value ?? '').trim();

    $('o-text-add').addEventListener('click', () => {
      const body = ($<HTMLTextAreaElement>('o-text-body').value ?? '').trim();
      if (!body) return;
      addItem({
        id: uid(),
        kind: 'text',
        title: val('o-text-title') || T('pres_add_text'),
        textContent: body,
      });
      renderOtherPanel();
    });

    const addImage = (url: string) => {
      if (!url) return;
      addItem({
        id: uid(),
        kind: 'image',
        title: T('pres_add_image'),
        imageUrl: url,
        imageCaption: val('o-img-caption') || undefined,
      });
      renderOtherPanel();
    };
    $('o-img-add').addEventListener('click', () => addImage(val('o-img-url')));
    $('o-img-file-btn').addEventListener('click', () => $<HTMLInputElement>('o-img-file').click());
    $<HTMLInputElement>('o-img-file').addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      input.value = '';
      if (file) addImage(await fileToDataUrl(file));
    });

    $('o-video-add').addEventListener('click', () => {
      const url = val('o-video-url');
      if (url) addItem({ id: uid(), kind: 'video', title: T('pres_add_video'), videoUrl: url });
      renderOtherPanel();
    });
    $('o-audio-add').addEventListener('click', () => {
      const url = val('o-audio-url');
      if (url) addItem({ id: uid(), kind: 'audio', title: T('pres_add_audio'), audioUrl: url });
      renderOtherPanel();
    });
    $('o-blank-add').addEventListener('click', () =>
      addItem({ id: uid(), kind: 'blank', title: T('pres_black_screen') })
    );
  }

  /** Remplit le sélecteur contextuel (recueil / version / catégorie). */
  async function syncScope() {
    perVerseWrap.classList.toggle('hidden', source !== 'bible');
    perVerseWrap.classList.toggle('flex', source === 'bible');
    scopeSel.classList.toggle('hidden', source === 'other');
    searchInput.classList.toggle('hidden', source === 'other');
    searchInput.placeholder = T(PLACEHOLDERS[source]);

    if (source === 'hymns') {
      scopeSel.innerHTML = HYMNAL_COLLECTIONS.map(
        (c) => `<option value="${esc(c.id)}">${esc(c.name)}</option>`
      ).join('');
    } else if (source === 'bible') {
      // Le sélecteur restait vide : l'ancien code ne le remplissait que si
      // `options.length === 1`, or il démarrait à zéro option.
      scopeSel.innerHTML = `<option>${esc(T('pres_loading'))}</option>`;
      try {
        const versions = await bibleVersions(BASE);
        scopeSel.innerHTML = versions
          .map((v) => `<option value="${esc(v.file)}"${v.isDefault ? ' selected' : ''}>${esc(v.name)}${v.language ? ` — ${esc(v.language)}` : ''}</option>`)
          .join('');
      } catch {
        scopeSel.innerHTML = `<option>${esc(T('pres_no_connection'))}</option>`;
      }
    } else if (source === 'docs') {
      docsData = docsData ?? (await loadDocs());
      scopeSel.innerHTML =
        `<option value="">${esc(T('documents_all'))}</option>` +
        (docsData?.cats ?? []).map((c) => `<option value="${esc(c.id)}">${esc(c.title)}</option>`).join('');
    }
  }

  async function showSource(s: SourceTab) {
    source = s;
    document.querySelectorAll<HTMLElement>('[data-src]').forEach((b) => {
      const on = b.dataset.src === s;
      b.classList.toggle('bg-gold-500/10', on);
      b.classList.toggle('text-gold-600', on);
      b.classList.toggle('dark:text-gold-400', on);
      b.setAttribute('aria-selected', String(on));
    });
    await syncScope();
    await runSearch();
  }

  document.querySelectorAll<HTMLElement>('[data-src]').forEach((b) =>
    b.addEventListener('click', () => void showSource(b.dataset.src as SourceTab))
  );
  scopeSel.addEventListener('change', () => void runSearch());
  searchInput.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    // La Bible ne cherche qu'à la validation : résoudre une référence
    // incomplète à chaque frappe n'a pas de sens et télécharge la base.
    if (source === 'bible') return;
    searchTimer = window.setTimeout(() => void runSearch(), 200);
  });
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') void runSearch();
  });

  // ══════════════════════ DÉROULÉ ══════════════════════

  const itemsList = $('items-list');
  const itemsCount = $('items-count');

  const KIND_ICON: Record<string, string> = {
    cantique: '🎵',
    bible: '📖',
    text: '📝',
    image: '🖼️',
    doc: '📄',
    video: '🎬',
    audio: '🎧',
    blank: '⬛',
  };

  function firstPageOf(index: number): number {
    return pres().items.slice(0, index).reduce((n, it) => n + itemPageCount(it), 0);
  }

  function addItem(item: PresentItem) {
    const p = pres();
    p.items.push(item);
    flatIndex = firstPageOf(p.items.length - 1);
    persist();
    renderAll();
    void resolveDocPages(item);
  }

  /**
   * Un PDF ajouté ne connaît pas encore son nombre de pages : il comptait donc
   * pour une seule page et la projection n'avançait jamais au-delà de la
   * première. On le demande à pdf.js après coup, puis on rafraîchit.
   */
  /** Rattrape les PDF déjà présents dans le déroulé, quelle que soit leur date d'ajout. */
  async function resolveAllDocPages() {
    for (const item of pres().items.slice()) await resolveDocPages(item);
  }

  async function resolveDocPages(item: PresentItem) {
    if (item.kind !== 'doc' || !item.docUrl || item.docPages) return;
    const pages = await pdfPageCount(item.docUrl).catch(() => 0);
    if (pages <= 1) return;
    // L'élément a pu être retiré ou la présentation changée entre-temps
    const target = pres().items.find((it) => it.id === item.id);
    if (!target) return;
    target.docPages = pages;
    persist();
    renderAll();
  }

  function renderItems() {
    const p = pres();
    itemsCount.textContent = String(p.items.length);
    if (!p.items.length) {
      itemsList.innerHTML = `<p class="rounded-xl border border-dashed border-slate-300/70 p-6 text-center text-xs text-slate-400 dark:border-night-600">${esc(T('pres_empty'))}</p>`;
      return;
    }

    let acc = 0;
    itemsList.innerHTML = p.items
      .map((it, i) => {
        const pages = itemPageCount(it);
        const first = acc;
        acc += pages;
        const on = flatIndex >= first && flatIndex < acc;
        return `
        <div draggable="true" data-index="${i}" class="item-row group cursor-grab rounded-xl border px-2.5 py-2 transition ${
          on
            ? 'border-gold-500 bg-gold-500/10'
            : 'border-slate-200/70 bg-white hover:border-gold-400/50 dark:border-night-700 dark:bg-night-900/60'
        }">
          <div class="flex items-center gap-2">
            <span class="shrink-0 text-sm">${KIND_ICON[it.kind] ?? '📄'}</span>
            <button data-select="${first}" class="min-w-0 flex-1 text-left">
              <span class="block truncate text-xs font-semibold text-slate-800 dark:text-slate-100">${esc(it.title)}</span>
              <span class="block truncate text-[10px] text-slate-400">${it.subtitle ? esc(it.subtitle) + ' · ' : ''}${pages} ${esc(T('pres_page_label'))}${pages > 1 ? 's' : ''}</span>
            </button>
            <button data-style="${i}" class="shrink-0 text-xs text-slate-400 opacity-0 transition hover:text-gold-600 group-hover:opacity-100" title="${esc(T('pres_customize'))}">⚙️</button>
            <button data-del="${i}" class="shrink-0 text-xs text-slate-400 opacity-0 transition hover:text-rose-500 group-hover:opacity-100" title="${esc(T('pres_delete'))}">✕</button>
          </div>
        </div>`;
      })
      .join('');

    bindItemRows();
  }

  function bindItemRows() {
    itemsList.querySelectorAll<HTMLElement>('[data-select]').forEach((b) =>
      b.addEventListener('click', () => {
        flatIndex = Number(b.dataset.select);
        persist();
        renderAll();
      })
    );
    itemsList.querySelectorAll<HTMLElement>('[data-del]').forEach((b) =>
      b.addEventListener('click', () => {
        const p = pres();
        p.items.splice(Number(b.dataset.del), 1);
        flatIndex = Math.min(flatIndex, Math.max(0, totalPages(p) - 1));
        persist();
        renderAll();
      })
    );
    itemsList.querySelectorAll<HTMLElement>('[data-style]').forEach((b) =>
      b.addEventListener('click', () => {
        styleTarget = pres().items[Number(b.dataset.style)] ?? null;
        openAppearance();
      })
    );

    // Réordonnancement par glisser-déposer (remplace les boutons ↑ ↓).
    let dragFrom = -1;
    itemsList.querySelectorAll<HTMLElement>('.item-row').forEach((row) => {
      row.addEventListener('dragstart', (e) => {
        dragFrom = Number(row.dataset.index);
        row.classList.add('opacity-40');
        e.dataTransfer?.setData('text/plain', String(dragFrom));
      });
      row.addEventListener('dragend', () => row.classList.remove('opacity-40'));
      row.addEventListener('dragover', (e) => {
        e.preventDefault();
        row.classList.add('ring-2', 'ring-gold-500/60');
      });
      row.addEventListener('dragleave', () => row.classList.remove('ring-2', 'ring-gold-500/60'));
      row.addEventListener('drop', (e) => {
        e.preventDefault();
        row.classList.remove('ring-2', 'ring-gold-500/60');
        const to = Number(row.dataset.index);
        const from = dragFrom >= 0 ? dragFrom : Number(e.dataTransfer?.getData('text/plain'));
        if (Number.isNaN(from) || from === to) return;
        const items = pres().items;
        const [moved] = items.splice(from, 1);
        items.splice(to, 0, moved);
        flatIndex = firstPageOf(to);
        persist();
        renderAll();
      });
    });
  }

  $('clear-items').addEventListener('click', () => {
    if (!pres().items.length) return;
    if (!window.confirm(T('pres_clear_confirm'))) return;
    pres().items = [];
    flatIndex = 0;
    persist();
    renderAll();
  });

  // ══════════════════════ APERÇU ══════════════════════

  const stage = $('preview-stage');
  const previewTitle = $('preview-title');
  const previewSub = $('preview-sub');
  const previewPage = $('preview-page');
  const pageStrip = $('page-strip');
  const launchBtn = $<HTMLButtonElement>('launch-btn');

  function fitStage() {
    const wrap = $('preview-wrap');
    const w = wrap.clientWidth - 10;
    const h = wrap.clientHeight - 10;
    if (w <= 0 || h <= 0) return;
    const scale = Math.min(w / 16, h / 9);
    stage.style.width = `${Math.max(280, Math.floor(scale * 16))}px`;
    stage.style.height = `${Math.max(158, Math.floor(scale * 9))}px`;
  }

  function renderPreview() {
    fitStage();
    const p = pres();
    const total = totalPages(p);
    if (!total) {
      stage.innerHTML = '';
      stage.style.background = backgroundValue(p.settings);
      previewTitle.textContent = T('pres_empty');
      previewSub.textContent = p.name;
      previewPage.textContent = '0 / 0';
      pageStrip.innerHTML = '';
      $('up-next').innerHTML = '';
      launchBtn.disabled = true;
      return;
    }

    flatIndex = Math.max(0, Math.min(flatIndex, total - 1));
    const at = pageAt(p, flatIndex)!;
    const s: PresentSettings = { ...p.settings, ...(at.item.settingsOverride ?? {}) };

    stage.style.background = backgroundValue(s);
    const base = { sm: 1.1, md: 1.35, lg: 1.6, xl: 1.9 }[s.textSize ?? 'lg'];
    stage.style.fontSize = `${(base * Math.min(stage.clientWidth || 900, 1400)) / 900}rem`;
    stage.innerHTML = `${bgMediaHtml(s)}<div style="position:relative;z-index:1;width:100%;height:100%">${pageHtml(at.item, at.page, s, T('pres_stanza'))}</div>`;
    void hydratePdfSlides(stage);

    previewTitle.textContent = at.item.title;
    previewSub.textContent = p.name;
    previewPage.textContent = `${flatIndex + 1} / ${total}`;
    launchBtn.disabled = false;

    renderPageStrip(at.itemIndex);
    renderUpNext(total);
  }

  /**
   * Extrait lisible du contenu d'une page. On lit l'élément plutôt que le HTML
   * de projection : ce dernier colle le titre au corps (« Fihirana1. RY
   * MPONINA…strophe 1… »), illisible dans une liste.
   */
  function pageExcerpt(item: PresentItem, page: number): string {
    let raw = '';
    switch (item.kind) {
      case 'cantique':
        raw = item.stanzas?.[page] ?? '';
        break;
      case 'bible':
        raw = (item.perVerse ? [item.verses?.[page]] : (item.verses ?? []))
          .filter(Boolean)
          .map((v) => v!.text)
          .join(' ');
        break;
      case 'text':
        raw = item.textContent ?? '';
        break;
      case 'image':
        raw = item.imageCaption ?? '';
        break;
      default:
        raw = item.subtitle ?? '';
    }
    return raw.replace(/\s+/g, ' ').trim().slice(0, 110);
  }

  /**
   * Aperçu texte des pages suivantes. En direct, savoir ce qui arrive au clic
   * suivant compte autant que voir la page courante.
   */
  function renderUpNext(total: number) {
    const p = pres();
    const box = $('up-next');
    const rows: string[] = [];
    for (let i = flatIndex + 1; i < Math.min(flatIndex + 9, total); i++) {
      const at = pageAt(p, i);
      if (!at) continue;
      const preview = pageExcerpt(at.item, at.page);
      rows.push(`
        <button data-next="${i}" class="w-full rounded-lg border border-slate-200/70 bg-white px-2.5 py-1.5 text-left transition hover:border-gold-400/60 dark:border-night-700 dark:bg-night-900/60">
          <span class="flex items-center gap-1.5">
            <span class="shrink-0 text-[10px] font-bold text-gold-600 dark:text-gold-400">${i + 1}</span>
            <span class="truncate text-[11px] font-semibold text-slate-700 dark:text-slate-200">${esc(at.item.title)}</span>
          </span>
          ${preview ? `<span class="mt-0.5 block truncate text-[10px] text-slate-400">${esc(preview)}</span>` : ''}
        </button>`);
    }
    box.innerHTML =
      rows.join('') ||
      `<p class="px-2 py-3 text-center text-[11px] text-slate-400">—</p>`;
    box.querySelectorAll<HTMLElement>('[data-next]').forEach((b) =>
      b.addEventListener('click', () => {
        flatIndex = Number(b.dataset.next);
        persist();
        renderAll();
      })
    );
  }

  /** Miniatures des pages de l'élément courant (strophes / versets). */
  function renderPageStrip(itemIndex: number) {
    const p = pres();
    const item = p.items[itemIndex];
    const first = firstPageOf(itemIndex);
    const pages = itemPageCount(item);
    if (pages <= 1) {
      pageStrip.innerHTML = '';
      return;
    }
    // Fenêtre glissante autour de la page courante : un PDF de plusieurs
    // centaines de pages produisait autant de boutons, et la bande devenait
    // inutilisable. Les bornes restent accessibles aux extrémités.
    const WINDOW = 12;
    const current = flatIndex - first;
    let from = Math.max(0, current - Math.floor(WINDOW / 2));
    const to = Math.min(pages, from + WINDOW);
    from = Math.max(0, to - WINDOW);

    const btn = (i: number) => {
      const on = first + i === flatIndex;
      return `<button data-page="${first + i}" class="shrink-0 rounded-lg border px-2.5 py-1 text-[11px] font-semibold transition ${
        on
          ? 'border-gold-500 bg-gold-500/15 text-gold-600 dark:text-gold-400'
          : 'border-slate-200/70 text-slate-500 hover:border-gold-400/60 dark:border-night-700 dark:text-slate-300'
      }">${i + 1}</button>`;
    };
    const gap = '<span class="shrink-0 px-1 text-[11px] text-slate-400">…</span>';

    pageStrip.innerHTML = [
      from > 0 ? btn(0) + (from > 1 ? gap : '') : '',
      Array.from({ length: to - from }, (_, k) => btn(from + k)).join(''),
      to < pages ? (to < pages - 1 ? gap : '') + btn(pages - 1) : '',
    ].join('');
    pageStrip.querySelectorAll<HTMLElement>('[data-page]').forEach((b) =>
      b.addEventListener('click', () => {
        flatIndex = Number(b.dataset.page);
        persist();
        renderAll();
      })
    );
  }

  function nav(delta: number) {
    const total = totalPages(pres());
    if (!total) return;
    flatIndex = Math.max(0, Math.min(flatIndex + delta, total - 1));
    persist();
    renderAll();
  }

  $('preview-prev').addEventListener('click', () => nav(-1));
  $('preview-next').addEventListener('click', () => nav(1));

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(renderPreview, 120);
  });

  // ══════════════════════ PRÉSENTATIONS ══════════════════════

  const presSelect = $<HTMLSelectElement>('pres-select');

  function renderPresList() {
    presSelect.innerHTML = presentations
      .map((p) => `<option value="${esc(p.id)}">${esc(p.name)}</option>`)
      .join('');
    presSelect.value = pres().id;
  }

  presSelect.addEventListener('change', () => {
    activeId = presSelect.value;
    flatIndex = 0;
    persist();
    renderAll();
  });

  $('pres-new').addEventListener('click', () => {
    const name = window.prompt(T('pres_name_placeholder'));
    if (name === null) return;
    const p = createDefault();
    p.name = name.trim() || p.name;
    presentations.push(p);
    activeId = p.id;
    flatIndex = 0;
    persist();
    renderAll();
  });

  $('pres-rename').addEventListener('click', () => {
    const p = pres();
    const name = window.prompt(T('pres_name_placeholder'), p.name);
    if (name === null) return;
    p.name = name.trim() || p.name;
    persist();
    renderAll();
  });

  $('pres-dup').addEventListener('click', () => {
    const src = pres();
    const copy: Presentation = {
      ...src,
      id: uid(),
      name: `${src.name} (2)`,
      updatedAt: Date.now(),
      items: JSON.parse(JSON.stringify(src.items)),
      settings: { ...src.settings },
    };
    presentations.push(copy);
    activeId = copy.id;
    flatIndex = 0;
    persist();
    renderAll();
  });

  $('pres-del').addEventListener('click', () => {
    const p = pres();
    if (!window.confirm(`${T('pres_delete')} : « ${p.name} » ?`)) return;
    presentations = presentations.filter((x) => x.id !== p.id);
    if (!presentations.length) presentations = [createDefault()];
    activeId = presentations[0].id;
    flatIndex = 0;
    persist();
    renderAll();
  });

  $('demo-btn').addEventListener('click', () => {
    const demo = demoPresentation();
    presentations.push(demo);
    activeId = demo.id;
    flatIndex = 0;
    persist();
    renderAll();
  });

  // ══════════════════════ PANNEAU APPARENCE ══════════════════════

  const appearance = $('appearance');
  const backdrop = $('appearance-backdrop');
  const bgPresetsEl = $('bg-presets');
  const bgValue = $<HTMLInputElement>('bg-value');
  const textColor = $<HTMLInputElement>('text-color');
  const textSize = $<HTMLSelectElement>('text-size');
  const positionSel = $<HTMLSelectElement>('position');
  const alignment = $<HTMLSelectElement>('alignment');
  const verseNumbers = $<HTMLInputElement>('verse-numbers');
  const autoAdvance = $<HTMLInputElement>('auto-advance');
  const bgMediaType = $<HTMLSelectElement>('bg-media-type');
  const bgMedia = $<HTMLInputElement>('bg-media');

  bgPresetsEl.innerHTML = BG_PRESETS.map(
    (p) =>
      `<button data-grad="${esc(p.value)}" class="h-8 w-8 rounded-lg border-2 border-white/40 transition hover:scale-110" style="background:${p.value}" title="${esc(p.label)}" aria-label="${esc(p.label)}"></button>`
  ).join('');

  function openAppearance() {
    appearance.classList.remove('hidden');
    appearance.classList.add('flex');
    backdrop.classList.remove('hidden');
    $('appearance-btn').setAttribute('aria-expanded', 'true');
    syncAppearance();
  }

  function closeAppearance() {
    appearance.classList.add('hidden');
    appearance.classList.remove('flex');
    backdrop.classList.add('hidden');
    $('appearance-btn').setAttribute('aria-expanded', 'false');
    styleTarget = null;
  }

  $('appearance-btn').addEventListener('click', () => {
    if (appearance.classList.contains('hidden')) {
      styleTarget = null;
      openAppearance();
    } else closeAppearance();
  });
  $('appearance-close').addEventListener('click', closeAppearance);
  backdrop.addEventListener('click', closeAppearance);

  function syncAppearance() {
    const s = targetSettings();
    $('appearance-target').textContent = styleTarget
      ? `${T('pres_customize')} — ${styleTarget.title}`
      : pres().name;

    bgValue.value = s.bgValue;
    textColor.value = s.textColor.startsWith('#') ? s.textColor : '#ffffff';
    textSize.value = s.textSize;
    positionSel.value = s.position;
    alignment.value = s.alignment;
    verseNumbers.checked = s.showVerseNumbers;
    autoAdvance.value = String(s.autoAdvance);
    bgMediaType.value = s.bgMediaType ?? 'none';
    bgMedia.value = s.bgMedia ?? '';

    document.querySelectorAll<HTMLElement>('[data-bg]').forEach((b) => {
      const on = b.dataset.bg === s.bgType;
      b.classList.toggle('border-gold-500', on);
      b.classList.toggle('text-gold-600', on);
      b.classList.toggle('dark:text-gold-400', on);
    });

    // Le défilement automatique appartient à la présentation, pas à un élément.
    autoAdvance.disabled = Boolean(styleTarget);
  }

  bgPresetsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-grad]') as HTMLElement | null;
    if (!b) return;
    applySetting('bgType', 'gradient');
    applySetting('bgValue', b.dataset.grad!);
  });

  document.querySelectorAll<HTMLElement>('[data-bg]').forEach((b) =>
    b.addEventListener('click', () => {
      const type = b.dataset.bg as PresentSettings['bgType'];
      applySetting('bgType', type);
      if (type === 'solid' && !targetSettings().bgValue.startsWith('#')) applySetting('bgValue', '#0b1020');
    })
  );

  bgValue.addEventListener('change', () => applySetting('bgValue', bgValue.value));
  textColor.addEventListener('input', () => applySetting('textColor', textColor.value));
  textSize.addEventListener('change', () => applySetting('textSize', textSize.value as any));
  positionSel.addEventListener('change', () => applySetting('position', positionSel.value as any));
  alignment.addEventListener('change', () => applySetting('alignment', alignment.value as any));
  verseNumbers.addEventListener('change', () => applySetting('showVerseNumbers', verseNumbers.checked));
  autoAdvance.addEventListener('change', () =>
    applySetting('autoAdvance', Math.max(0, Number(autoAdvance.value) || 0))
  );
  bgMediaType.addEventListener('change', () => applySetting('bgMediaType', bgMediaType.value as any));
  bgMedia.addEventListener('change', () => applySetting('bgMedia', bgMedia.value.trim()));

  $('bg-upload-btn').addEventListener('click', () => $<HTMLInputElement>('bg-upload').click());
  $<HTMLInputElement>('bg-upload').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    try {
      applySetting('bgType', 'image');
      applySetting('bgValue', await fileToDataUrl(file));
    } catch {
      window.alert(T('pres_image_error'));
    }
  });

  $('bg-clear').addEventListener('click', () => {
    applySetting('bgType', 'gradient');
    applySetting('bgValue', DEFAULT_SETTINGS.bgValue);
  });

  $('appearance-reset').addEventListener('click', () => {
    if (styleTarget) {
      styleTarget.settingsOverride = undefined;
    } else {
      pres().settings = { ...DEFAULT_SETTINGS };
    }
    persist();
    renderAll();
    syncAppearance();
  });

  // --- Superpositions du projecteur ---
  let overlays: PresOverlays = loadOverlays();
  const ovFields = {
    clockFormat: $<HTMLSelectElement>('ov-clock-format'),
    timerSec: $<HTMLInputElement>('ov-timer-sec'),
    timerOn: $<HTMLInputElement>('ov-timer-on'),
    tickerText: $<HTMLInputElement>('ov-ticker-text'),
    tickerSpeed: $<HTMLInputElement>('ov-ticker-speed'),
    tickerOn: $<HTMLInputElement>('ov-ticker-on'),
  };

  function syncOverlays() {
    ovFields.clockFormat.value = overlays.clockFormat;
    ovFields.timerSec.value = String(overlays.timerSeconds);
    ovFields.timerOn.checked = overlays.timerOn;
    ovFields.tickerText.value = overlays.tickerText;
    ovFields.tickerSpeed.value = String(overlays.tickerSpeed);
    ovFields.tickerOn.checked = overlays.tickerOn;
  }

  Object.values(ovFields).forEach((el) =>
    el.addEventListener('change', () => {
      overlays = {
        clockFormat: ovFields.clockFormat.value as PresOverlays['clockFormat'],
        timerOn: ovFields.timerOn.checked,
        timerSeconds: Math.max(0, Number(ovFields.timerSec.value) || 0),
        tickerOn: ovFields.tickerOn.checked,
        tickerText: ovFields.tickerText.value,
        tickerSpeed: Math.max(1, Number(ovFields.tickerSpeed.value) || 60),
      };
      saveOverlays(overlays);
    })
  );

  // ══════════════════════ PROJECTION ══════════════════════

  launchBtn.addEventListener('click', () => {
    persist();
    if (projector && !projector.closed) {
      projector.focus();
      return;
    }
    projector = window.open(`${BASE}presentation/projector`, 'ah-projector', 'popup,width=1280,height=720');
    if (!projector) window.alert(T('pres_popup_blocked'));
  });

  // ══════════════════════ IMPORT / EXPORT ══════════════════════

  async function withBusy(btn: HTMLElement, label: string, fn: () => Promise<string>) {
    const original = btn.innerHTML;
    btn.setAttribute('disabled', 'true');
    btn.textContent = label;
    try {
      btn.textContent = await fn();
    } catch (err) {
      btn.textContent = `❌ ${(err as Error).message}`;
    } finally {
      window.setTimeout(() => {
        btn.innerHTML = original;
        btn.removeAttribute('disabled');
      }, 2000);
    }
  }

  $('export-zip').addEventListener('click', () =>
    withBusy($('export-zip'), T('pres_exporting'), async () => {
      const { downloadZip } = await import('@/lib/presentation-export');
      await downloadZip();
      return '✅';
    })
  );

  $('import-zip-btn').addEventListener('click', () => $<HTMLInputElement>('import-zip').click());
  $<HTMLInputElement>('import-zip').addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    void withBusy($('import-zip-btn'), T('pres_importing'), async () => {
      const { importPresentationsZip } = await import('@/lib/presentation-export');
      const res = await importPresentationsZip(file);
      presentations = loadPresentations();
      if (!presentations.some((p) => p.id === activeId)) activeId = presentations[0]?.id ?? null;
      if (!presentations.length) presentations = [createDefault()];
      flatIndex = 0;
      persist();
      renderAll();
      return `✅ ${res.presentations}`;
    });
  });

  // ══════════════════════ CLAVIER ══════════════════════

  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement)?.tagName;
    const typing = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';

    if (e.key === 'Escape') {
      closeAppearance();
      if (typing) (e.target as HTMLElement).blur();
      return;
    }
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      launchBtn.click();
      return;
    }
    if (typing) return;

    if (e.key === '/') {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    } else if (e.key === 'ArrowRight' || e.key === ' ') {
      e.preventDefault();
      nav(1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      nav(-1);
    }
  });

  // Le projecteur écrit la page courante : le studio suit.
  window.addEventListener('storage', (ev) => {
    if (ev.key === 'ah-presentation-active' && ev.newValue) {
      try {
        const act = JSON.parse(ev.newValue);
        if (act?.presId === pres().id && typeof act.pageIndex === 'number' && act.pageIndex !== flatIndex) {
          flatIndex = act.pageIndex;
          renderItems();
          renderPreview();
        }
      } catch {
        /* valeur illisible : on ignore */
      }
    }
    if (ev.key === 'ah-pres-overlays') {
      overlays = loadOverlays();
      syncOverlays();
    }
  });

  // ══════════════════════ LIENS PROFONDS ══════════════════════

  /** `?add=cantique&song=<id>` · `?add=doc&url=…&title=…` · `?add=bible&ref=…` */
  async function handleDeepLink() {
    const params = new URLSearchParams(location.search);
    const add = params.get('add');
    if (!add) return;
    history.replaceState(null, '', `${BASE}presentation`);

    try {
      if (add === 'cantique') {
        const song = await findSong(params.get('song') ?? '');
        if (song) addItem(songToItem(song));
      } else if (add === 'doc' && params.get('url')) {
        const url = params.get('url')!;
        addItem({
          id: uid(),
          kind: 'doc',
          title: params.get('title') ?? url.split('/').pop() ?? T('pres_add_doc'),
          subtitle: T('pres_add_doc'),
          docPath: url,
          docUrl: url,
        });
      } else if (add === 'bible' && params.get('ref')) {
        const version = params.get('version') ?? '';
        const ref = await resolveReference(BASE, version, params.get('ref')!);
        if (ref) addItem(bibleToItem(ref, version || 'Bible', false));
      }
    } catch {
      /* lien invalide : on reste sur le déroulé courant */
    }
  }

  // ══════════════════════ AMORÇAGE ══════════════════════

  function renderAll() {
    renderPresList();
    renderItems();
    renderPreview();
  }

  syncOverlays();
  renderAll();
  requestAnimationFrame(renderPreview);
  void showSource('hymns').then(() => handleDeepLink());
  // Les PDF ajoutés avant que le nombre de pages soit résolu comptent encore
  // pour une seule page : on les rattrape à l'ouverture.
  void resolveAllDocPages();
</script>

<style>
  kbd {
    display: inline-block;
    border: 1px solid rgb(148 163 184 / 0.4);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 4px;
    font-family: ui-monospace, monospace;
    font-size: 9px;
  }
  /* Le panneau Apparence est masqué par `hidden` ; `flex` le réaffiche. */
  #appearance.flex {
    display: flex;
  }
</style>
