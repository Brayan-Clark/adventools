---
import Layout from '@/layouts/Layout.astro';
import { supabase } from '@/lib/supabase';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

// Site 100% statique (GitHub Pages) : la liste des slugs est générée au build
// depuis Supabase, le contenu de la page est chargé côté client.
export async function getStaticPaths() {
  const { data } = await supabase.from('media').select('slug').eq('type', 'article');
  return (data ?? []).map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const lang: Lang = 'fr';
---

<Layout lang={lang} title={t(lang, 'nav_articles')}>
  <!-- État de chargement -->
  <section id="detail-loading" class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div class="h-4 w-56 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
    <div class="mt-8 space-y-3 text-center">
      <div class="mx-auto h-6 w-40 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="mx-auto h-10 w-3/4 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="mx-auto h-4 w-1/2 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="mt-8 aspect-[21/9] animate-pulse rounded-2xl bg-slate-200/70 dark:bg-night-800/70"></div>
      <div class="space-y-2 pt-6">
        <div class="h-4 w-full animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
        <div class="h-4 w-full animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
        <div class="h-4 w-2/3 animate-pulse rounded bg-slate-200/70 dark:bg-night-800/70"></div>
      </div>
    </div>
  </section>

  <!-- Contenu introuvable -->
  <section id="detail-notfound" class="hidden mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-6xl">📜</p>
    <h1 class="mt-4 font-display text-3xl font-bold">{t(lang, 'not_found_title')}</h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">{t(lang, 'not_found_text')}</p>
    <a href="/" class="btn-gold mt-8">{t(lang, 'back_home')}</a>
  </section>

  <!-- Contenu rendu côté client -->
  <section id="detail-content" class="hidden mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div id="detail-body"></div>
  </section>
</Layout>

<script>
  import { getMediaBySlug, getMedia } from '@/lib/supabase';
  import { clientLang, mediaCardHtml, formatViews, formatDate } from '@/lib/client-render';
  import { t, pickTitle, pickDescription } from '@/lib/i18n';
  import type { MediaItem } from '@/lib/types';

  const lang = clientLang();
  const BASE = import.meta.env.BASE_URL ?? '/';

  // Slug extrait de l'URL (compatible base GitHub Pages : /base/type/slug)
  const slug = window.location.pathname.split('/').filter(Boolean).pop() ?? '';

  const esc = (s: unknown): string =>
    String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
    );

  function show(id: string, ok: boolean) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('hidden', !ok);
  }

  function revealAll() {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
  }

  // Découpe simple : lignes vides = paragraphes, lignes ## = sous-titres
  function blocksHtml(item: MediaItem): string {
    const body = lang === 'mg' && item.content_mg ? item.content_mg : item.content_fr ?? '';
    const blocks = body
      .split(/\n{2,}/)
      .map((b) => b.trim())
      .filter(Boolean);

    if (!blocks.length) {
      return `<p class="mt-10 text-center text-slate-500 dark:text-slate-400">${t(lang, 'no_description')}</p>`;
    }
    return `<div class="mt-10 space-y-8">${blocks.map((block) => {
      const heading = block.startsWith('## ');
      const text = heading ? block.slice(3) : block;
      if (heading) {
        return `<h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">${esc(text)}</h2>`;
      }
      return `<p class="prose prose-slate max-w-none text-[17px] leading-relaxed text-slate-700 dark:prose-invert dark:text-slate-300">${esc(text)}</p>`;
    }).join('')}</div>`;
  }

  function bodyHtml(item: MediaItem): string {
    const title = pickTitle(item, lang);
    const body = lang === 'mg' && item.content_mg ? item.content_mg : item.content_fr ?? '';
    const readingMinutes = body ? Math.max(1, Math.round(body.split(/\s+/).length / 200)) : 0;

    const chips: string[] = [];
    if (item.category) {
      chips.push(
        `<span class="chip border border-sky-500/40 bg-sky-500/10 text-sky-600 dark:text-sky-300">${lang === 'mg' ? esc(item.category.name_mg) : esc(item.category.name_fr)}</span>`
      );
    }
    chips.push(
      `<span class="chip border border-slate-300/70 text-slate-500 dark:border-night-600 dark:text-slate-400">
        <svg class="mr-1 inline h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2z" />
        </svg>
        ${readingMinutes} ${t(lang, 'reading_time')}
      </span>`
    );

    const meta: string[] = [];
    if (item.speaker) {
      meta.push(
        `<span class="flex items-center gap-1.5"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-3.31 0-8 1.67-8 5v1h16v-1c0-3.33-4.69-5-8-5z" /></svg>${t(lang, 'by_speaker')} <span class="font-medium text-slate-700 dark:text-slate-200">${esc(item.speaker)}</span></span>`
      );
    }
    if (item.date) {
      meta.push(
        `<span class="flex items-center gap-1.5"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2h2v2h6V2h2v2h2a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2h2V2zm0 6H5v12h14V8H7z" /></svg>${formatDate(item.date, lang)}</span>`
      );
    }
    meta.push(
      `<span class="flex items-center gap-1.5"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12a4.5 4.5 0 110-9 4.5 4.5 0 010 9zm0-7a2.5 2.5 0 100 5 2.5 2.5 0 000-5z" /></svg>${formatViews(item.views ?? 0)} ${t(lang, 'views')}</span>`
    );

    const cover = item.image
      ? `<div class="mt-8 overflow-hidden rounded-2xl border border-slate-200/70 shadow-sm dark:border-night-700/60">
          <img src="${esc(item.image)}" alt="" class="aspect-[21/9] w-full object-cover" />
        </div>`
      : '';

    const tags = (item.tags ?? []).length
      ? `<div class="mt-10 flex flex-wrap justify-center gap-2">${(item.tags ?? []).map((tag) => `<span class="chip border border-slate-300/70 text-slate-500 dark:border-night-600 dark:text-slate-400">#${esc(tag)}</span>`).join('')}</div>`
      : '';

    return `
      <nav class="mb-6 text-xs text-slate-400" aria-label="Fil d'ariane">
        <a href="${BASE}" class="hover:text-gold-600 dark:hover:text-gold-400">${t(lang, 'nav_home')}</a>
        <span class="mx-1">/</span>
        <a href="${BASE}articles" class="hover:text-gold-600 dark:hover:text-gold-400">${t(lang, 'nav_articles')}</a>
        <span class="mx-1">/</span>
        <span class="text-slate-600 dark:text-slate-300">${esc(title)}</span>
      </nav>

      <article class="reveal">
        <!-- En-tête article -->
        <header class="text-center">
          <div class="flex flex-wrap items-center justify-center gap-2">${chips.join('')}</div>

          <h1 class="mt-5 font-display text-3xl font-bold leading-tight text-slate-900 sm:text-4xl dark:text-white">${esc(title)}</h1>

          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-500 dark:text-slate-400">${esc(pickDescription(item, lang) || t(lang, 'no_description'))}</p>

          <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-slate-500 dark:text-slate-400">${meta.join('')}</div>
        </header>

        ${cover}

        ${blocksHtml(item)}

        ${tags}

        <!-- Partage simple -->
        <div class="mt-10 border-t border-slate-200/60 pt-8 text-center dark:border-night-700/60">
          <p class="text-sm text-slate-500 dark:text-slate-400">${t(lang, 'footer_about_title')}</p>
          <button id="share-btn" type="button" class="btn-gold mt-4">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14 5l7 7-7 7v-4c-5 0-9 2-11 6 1-7 5-12 11-13V5z" />
            </svg>
            ${lang === 'mg' ? 'Zarao' : 'Partager'}
          </button>
        </div>
      </article>

      <div id="related-section" class="reveal mt-14">
        <h2 class="font-display text-xl font-semibold text-slate-900 dark:text-white">${t(lang, 'related')}</h2>
        <div id="related-grid" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>`;
  }

  async function load() {
    let item: MediaItem | null = null;
    try {
      item = await getMediaBySlug(slug);
    } catch {
      item = null;
    }

    if (!item || item.type !== 'article') {
      show('detail-loading', false);
      show('detail-content', false);
      show('detail-notfound', true);
      const nf = document.getElementById('detail-notfound');
      if (nf) {
        const h1 = nf.querySelector('h1');
        const p = nf.querySelector('p');
        const a = nf.querySelector('a');
        if (h1) h1.textContent = t(lang, 'not_found_title');
        if (p) p.textContent = t(lang, 'not_found_text');
        if (a) a.textContent = t(lang, 'back_home');
      }
      return;
    }

    show('detail-loading', false);
    show('detail-content', true);
    document.title = `${pickTitle(item, lang)} · Andeaha Hizaha`;

    const body = document.getElementById('detail-body');
    if (body) body.innerHTML = bodyHtml(item);

    // Partage
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', () => {
      const url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url }).catch(() => {});
      } else {
        navigator.clipboard?.writeText(url).catch(() => {});
      }
    });

    // À découvrir aussi (même type, item courant exclu)
    const related = (await getMedia({ type: 'article', limit: 3 }).catch(() => []))
      .filter((m) => m.slug !== slug);
    const relatedSection = document.getElementById('related-section');
    const relatedGrid = document.getElementById('related-grid');
    if (relatedGrid && related.length) {
      relatedGrid.innerHTML = related.map((m) => mediaCardHtml(m, lang)).join('');
    } else if (relatedSection) {
      relatedSection.classList.add('hidden');
    }

    revealAll();
  }

  load();
</script>
