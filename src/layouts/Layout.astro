---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AiChat from '@/components/AiChat.astro';
import type { Lang } from '@/lib/types';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
}

// Les chemins des fichiers de public/ doivent inclure le base path : Astro ne
// préfixe que ses propres assets. Ils étaient écrits en dur (`/favicon.svg`) et
// rattrapés après coup par scripts/fix-base.mjs, ce qui laissait `astro dev`
// en erreur permanente sur chaque page.
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');

const {
  title = 'Andeaha Hizaha — Plateforme d’étude biblique',
  description = 'Sermons vidéo, cours bibliques, audio & séminaires pour grandir ensemble dans la foi.',
  lang = 'fr',
  image = `${BASE}favicon.svg`,
} = Astro.props;

const siteTitle = 'Andeaha Hizaha';
const fullTitle = `${title} · ${siteTitle}`;

// og:image doit être une URL absolue pour les aperçus de partage.
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${BASE}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Init thème avant rendu pour éviter le flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('ah-theme');
          var dark = stored ? stored === 'dark' : true;
          if (dark) document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
        // Marque l'exécution du JS : l'apparition au défilement n'est appliquée
        // que dans ce cas. Sans ce garde-fou, une erreur de script laissait des
        // sections entières en opacity:0 — invisibles mais occupant la place.
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-[#f6f3ee] text-slate-800 transition-colors duration-300 dark:bg-night-950 dark:text-slate-200"
  >
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-gold-500 focus:px-4 focus:py-2 focus:text-night-950"
    >
      Aller au contenu
    </a>

    <Header lang={lang} />

    <main id="contenu">
      <slot />
    </main>

    <Footer lang={lang} />

    <AiChat lang={lang} />

    <!-- Enregistrement du service worker PWA -->
    <script>
      // Le service worker n'est généré qu'au build (devOptions.enabled: false) :
      // l'enregistrer en dev produisait des 404 en boucle sur /sw.js.
      if (import.meta.env.PROD) {
        const { registerSW } = await import('virtual:pwa-register');
        registerSW({ immediate: true });
      }

      // Purge des service workers hérités : ceux enregistrés à la racine (avant
      // que le site ne vive sous /adventools/) survivent aux mises à jour et
      // continuent de rejouer d'anciennes URL, dont les /api/* supprimées.
      if ('serviceWorker' in navigator) {
        const base = new URL(import.meta.env.BASE_URL ?? '/', location.origin).href;
        navigator.serviceWorker
          .getRegistrations()
          .then((regs) =>
            Promise.all(
              regs.filter((r) => !r.scope.startsWith(base)).map((r) => r.unregister())
            )
          )
          .catch(() => {
            /* API indisponible : rien à purger */
          });
      }
    </script>
    <script>
      // Langue côté client.
      //
      // Le site est prérendu en français : le cookie `ah-lang` que posait le
      // sélecteur de langue n'était jamais lu (il n'y a pas de serveur). On
      // applique donc la langue dans le navigateur : `<html lang>` est corrigé
      // — c'est lui que lisent tous les scripts de page — et les éléments
      // porteurs de `data-i18n` sont retraduits.
      import { t } from '@/lib/i18n';
      import { clientLang, setClientLang } from '@/lib/client-render';

      const lang = clientLang();
      setClientLang(lang);
      document.documentElement.lang = lang;

      if (lang !== 'fr') {
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n;
          if (key) el.textContent = t(lang, key as any);
        });
      }
    </script>
    <script>
      // Révélation douce des sections au scroll
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Filet de sécurité : l'animation ne doit jamais conditionner la lecture.
      // Les sections dont le contenu arrive par fetch sont masquées au premier
      // passage de l'observateur, qui ne les rattrapait pas toujours une fois
      // affichées — la Bibliothèque et la Méditation du jour restaient alors
      // invisibles tout en occupant la place. Passé ce délai, tout est montré.
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => el.classList.add('visible'));
      }, 2500);
    </script>
  </body>
</html>
