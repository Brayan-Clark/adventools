---
import { t } from '@/lib/i18n';
import { ICONS } from '@/lib/icons';
import type { Lang } from '@/lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'fr' } = Astro.props;

// Navigation groupée : 3 menus déroulants + Accueil + Assistant
const navGroups = [
  {
    key: 'watch',
    label: t(lang, 'nav_group_watch'),
    icon: ICONS.video,
    color: 'from-indigo-500 to-violet-600',
    items: [
      { href: '/sermons', label: t(lang, 'nav_sermons'), icon: ICONS.video },
      { href: '/conferences', label: t(lang, 'nav_conferences'), icon: ICONS.mic },
      { href: '/seminaires', label: t(lang, 'nav_seminars'), icon: ICONS.users },
    ],
  },
  {
    key: 'listen',
    label: t(lang, 'nav_group_listen'),
    icon: ICONS.music,
    color: 'from-amber-500 to-orange-600',
    items: [
      { href: '/audio', label: t(lang, 'nav_audio'), icon: ICONS.music },
      { href: '/cantiques', label: t(lang, 'nav_cantiques'), icon: ICONS.music },
    ],
  },
  {
    key: 'study',
    label: t(lang, 'nav_group_study'),
    icon: ICONS.sparkles,
    color: 'from-emerald-500 to-teal-600',
    items: [
      { href: '/bible', label: t(lang, 'nav_bible'), icon: ICONS.book },
      { href: '/cours', label: t(lang, 'nav_courses'), icon: ICONS.cap },
      { href: '/articles', label: t(lang, 'nav_articles'), icon: ICONS.article },
      { href: '/mofonaina', label: t(lang, 'nav_mofonaina'), icon: ICONS.sparkles },
      { href: '/documents', label: t(lang, 'nav_documents'), icon: ICONS.document },
      { href: '/presentation', label: t(lang, 'nav_presentation'), icon: ICONS.screen },
      { href: '/applications', label: t(lang, 'nav_apps'), icon: ICONS.screen },
      { href: '/apropos', label: t(lang, 'nav_about'), icon: ICONS.info },
    ],
  },
];

// Les fichiers de public/ doivent porter le base path, sinon le routeur
// d'astro dev les rejette (« Request URLs for public/ assets must also
// include your base »).
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
// Un groupe est actif si l'une de ses pages est ouverte
const isGroupActive = (hrefs: string[]) => hrefs.some((h) => pathname.startsWith(h));
const otherLang: Lang = lang === 'fr' ? 'mg' : 'fr';

const linkBase =
  'rounded-full px-3.5 py-2 text-sm font-medium transition flex items-center gap-1.5';
const linkActive =
  'bg-gold-500/15 font-semibold text-gold-600 shadow-sm shadow-gold-500/20 dark:text-gold-400';
const linkIdle =
  'text-slate-600 hover:bg-gold-500/10 hover:text-gold-600 dark:text-slate-300 dark:hover:text-gold-400';
---

<header class="sticky top-0 z-50 glass-strong border-b border-slate-200/60 shadow-sm dark:border-night-700/60">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-2 px-4 sm:gap-3 sm:px-6">
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Andeaha Hizaha — Accueil">
      <img src={`${BASE}favicon.svg`} alt="" class="h-9 w-9 rounded-xl shadow-soft-gold" width="36" height="36" />
      <span class="hidden font-display text-lg font-semibold tracking-tight text-slate-900 md:block dark:text-white">
        Andeaha <span class="text-gradient-gold">Hizaha</span>
      </span>
    </a>

    <!-- Navigation desktop (groupée) -->
    <nav class="ml-2 hidden items-center gap-0.5 lg:flex xl:gap-1" aria-label="Navigation principale">
      <!-- Accueil -->
      <a href="/" aria-current={isActive('/') ? 'page' : undefined} class:list={[linkBase, isActive('/') ? linkActive : linkIdle]}>
        {isActive('/') && <span class="mr-0.5">✦</span>}
        {t(lang, 'nav_home')}
      </a>

      <!-- Groupes déroulants -->
      {navGroups.map((g) => {
        const active = isGroupActive(g.items.map((i) => i.href));
        return (
          <div class="relative" data-nav-group>
            <button
              type="button"
              aria-haspopup="true"
              :aria-expanded="'false'"
              data-nav-trigger
              class:list={[linkBase, 'cursor-pointer', active ? linkActive : linkIdle]}
            >
              {active && <span class="mr-0.5">✦</span>}
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d={g.icon} /></svg>
              {g.label}
              <svg class="nav-chevron h-3.5 w-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Panneau déroulant -->
            <div data-nav-panel class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 translate-y-1 transition-all duration-200">
              <div class="w-60 overflow-hidden rounded-2xl border border-slate-200/70 bg-white/95 p-2 shadow-soft backdrop-blur-xl dark:border-night-600 dark:bg-night-800/95">
                {g.items.map((item) => {
                  const itemActive = isActive(item.href);
                  return (
                    <a
                      href={item.href}
                      aria-current={itemActive ? 'page' : undefined}
                      class:list={[
                        'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition',
                        itemActive
                          ? 'bg-gold-500/15 text-gold-600 dark:text-gold-400'
                          : 'text-slate-700 hover:bg-gold-500/10 hover:text-gold-600 dark:text-slate-200 dark:hover:text-gold-400',
                      ]}
                    >
                      <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br ${g.color} text-white shadow`}>
                        <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d={item.icon} /></svg>
                      </span>
                      <span class="min-w-0 flex-1 truncate">{item.label}</span>
                      {itemActive && <span class="shrink-0 text-xs">✦</span>}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}

      <!-- Assistant IA (action principale) -->
      <a
        href="/assistant"
        aria-current={isActive('/assistant') ? 'page' : undefined}
        class="ml-1 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-600 px-4 py-2 text-xs font-bold text-night-950 shadow-soft-gold transition-all duration-300 hover:brightness-110 active:scale-95"
      >
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2zm7 11l.95 2.55L22.5 16.5l-2.55.95L19 20l-.95-2.55L15.5 16.5l2.55-.95L19 13zm-9 3l.75 2L12.5 18.75l-2.75.75L9 22.25 8.25 19.5 5.5 18.75l2.75-.75L9 15.25z" />
        </svg>
        {t(lang, 'nav_assistant')}
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      <!-- Recherche -->
      <a
        href="/recherche"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-500 transition hover:bg-gold-500/10 hover:text-gold-600 dark:text-slate-300 dark:hover:text-gold-400"
        aria-label={t(lang, 'search_placeholder')}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
        </svg>
      </a>

      <!-- Bascule langue -->
      <a
        href="?lang={otherLang}"
        data-lang-switch={otherLang}
        class="inline-flex h-10 items-center rounded-full border border-slate-300/70 px-3 text-xs font-bold uppercase tracking-wider text-slate-500 transition hover:border-gold-500/60 hover:text-gold-600 dark:border-night-600 dark:text-slate-300 dark:hover:text-gold-400"
        title="Français / Malagasy"
      >
        {otherLang === 'mg' ? 'MG' : 'FR'}
      </a>

      <!-- Bascule thème -->
      <button
        id="theme-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-500 transition hover:bg-gold-500/10 hover:text-gold-600 dark:text-slate-300 dark:hover:text-gold-400"
        aria-label="Changer de thème"
      >
        <svg class="h-5 w-5 block dark:hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M21.6 13.2A9 9 0 0110.8 2.4 9 9 0 1021.6 13.2z" />
        </svg>
        <svg class="h-5 w-5 hidden dark:block" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 17a5 5 0 100-10 5 5 0 000 10zm0-12a1 1 0 011 1v1a1 1 0 11-2 0V6a1 1 0 011-1zm0 12a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM6 11a1 1 0 011 1 1 1 0 11-2 0 1 1 0 011-1zm12 0a1 1 0 011 1 1 1 0 11-2 0 1 1 0 011-1zM7.05 4.64a1 1 0 011.41.07l.71.71a1 1 0 01-1.48 1.34l-.7-.7a1 1 0 01.06-1.42zm11.9 14.72a1 1 0 01-1.41-.07l-.7-.71a1 1 0 011.48-1.34l.7.7a1 1 0 01-.07 1.42zM4.64 7.05a1 1 0 01.07 1.41l.71.71a1 1 0 011.34-1.48l-.7-.7a1 1 0 01-1.42.06zm14.72 11.9a1 1 0 01-.07-1.41l-.71-.7a1 1 0 00-1.34 1.48l.7.7a1 1 0 001.42-.07z" clip-rule="evenodd" />
        </svg>
      </button>

      <!-- Menu mobile -->
      <button
        id="menu-btn"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-500 transition hover:bg-gold-500/10 lg:hidden dark:text-slate-300"
        aria-label={t(lang, 'nav_menu')}
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile (groupé) -->
  <nav id="mobile-menu" class="hidden border-t border-slate-200/60 lg:hidden dark:border-night-700/60">
    <div class="max-h-[70vh] space-y-1 overflow-y-auto px-4 pb-6 pt-3 sm:px-6">
      <!-- Recherche -->
      <a
        href="/recherche"
        class="mb-3 flex items-center gap-2.5 rounded-xl border border-slate-300/70 bg-white/70 px-4 py-3 text-sm text-slate-500 transition hover:border-gold-500/60 hover:text-gold-600 dark:border-night-600 dark:bg-night-800/60 dark:text-slate-300"
      >
        <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
        </svg>
        {t(lang, 'search_placeholder')}
      </a>

      <!-- Accueil -->
      <a
        href="/"
        aria-current={isActive('/') ? 'page' : undefined}
        class:list={[
          'block rounded-xl px-4 py-3 text-sm font-medium transition',
          isActive('/')
            ? 'bg-gold-500/15 font-semibold text-gold-600 dark:text-gold-400'
            : 'text-slate-700 hover:bg-gold-500/10 hover:text-gold-600 dark:text-slate-200 dark:hover:text-gold-400',
        ]}
      >
        {isActive('/') && <span class="mr-1.5">✦</span>}
        {t(lang, 'nav_home')}
      </a>

      <!-- Groupes -->
      {navGroups.map((g) => {
        const active = isGroupActive(g.items.map((i) => i.href));
        return (
          <div class="pt-3">
            <p class="mb-1.5 flex items-center gap-2 px-2 text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">
              <span class={`flex h-5 w-5 items-center justify-center rounded-md bg-gradient-to-br ${g.color} text-white`}>
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d={g.icon} /></svg>
              </span>
              {g.label}
            </p>
            <div class="space-y-0.5">
              {g.items.map((item) => {
                const itemActive = isActive(item.href);
                return (
                  <a
                    href={item.href}
                    aria-current={itemActive ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2.5 rounded-xl px-4 py-2.5 text-sm font-medium transition',
                      itemActive
                        ? 'bg-gold-500/15 font-semibold text-gold-600 dark:text-gold-400'
                        : 'text-slate-700 hover:bg-gold-500/10 hover:text-gold-600 dark:text-slate-200 dark:hover:text-gold-400',
                    ]}
                  >
                    <svg class="h-4 w-4 shrink-0 text-slate-400 dark:text-slate-500" fill="currentColor" viewBox="0 0 24 24"><path d={item.icon} /></svg>
                    {itemActive && <span class="mr-0.5">✦</span>}
                    {item.label}
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}

      <!-- Assistant IA -->
      <a
        href="/assistant"
        aria-current={isActive('/assistant') ? 'page' : undefined}
        class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 px-4 py-3 text-sm font-bold text-night-950 shadow-soft-gold transition hover:brightness-110 active:scale-[0.98]"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2zm7 11l.95 2.55L22.5 16.5l-2.55.95L19 20l-.95-2.55L15.5 16.5l2.55-.95L19 13zm-9 3l.75 2L12.5 18.75l-2.75.75L9 22.25 8.25 19.5 5.5 18.75l2.75-.75L9 15.25z" />
        </svg>
        {t(lang, 'nav_assistant')}
      </a>
    </div>
  </nav>
</header>

<script>
  // Thème
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('ah-theme', isDark ? 'dark' : 'light');
  });

  // Menu mobile
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openMobile = () => {
    mobileMenu?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
  };
  const closeMobile = () => {
    mobileMenu?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
  };
  menuBtn?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('hidden')) openMobile();
    else closeMobile();
  });
  // Ferme le menu mobile après un clic sur un lien
  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMobile));

  // Menus déroulants desktop
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  function closeAll(except?: HTMLElement) {
    groups.forEach((g) => {
      if (g === except) return;
      const panel = g.querySelector('[data-nav-panel]') as HTMLElement;
      const trigger = g.querySelector('[data-nav-trigger]') as HTMLElement;
      const chevron = g.querySelector('.nav-chevron') as HTMLElement;
      panel?.classList.add('invisible', 'opacity-0', 'translate-y-1');
      trigger?.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    });
  }
  function openGroup(g: HTMLElement) {
    closeAll(g);
    const panel = g.querySelector('[data-nav-panel]') as HTMLElement;
    const trigger = g.querySelector('[data-nav-trigger]') as HTMLElement;
    const chevron = g.querySelector('.nav-chevron') as HTMLElement;
    panel?.classList.remove('invisible', 'opacity-0', 'translate-y-1');
    trigger?.setAttribute('aria-expanded', 'true');
    chevron?.classList.add('rotate-180');
  }
  groups.forEach((g) => {
    g.addEventListener('mouseenter', () => openGroup(g));
    g.addEventListener('mouseleave', () => closeAll());
    const trigger = g.querySelector('[data-nav-trigger]');
    trigger?.addEventListener('click', () => {
      const panel = g.querySelector('[data-nav-panel]') as HTMLElement;
      if (panel?.classList.contains('invisible')) openGroup(g);
      else closeAll();
    });
    // Ferme le menu après navigation
    g.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeAll()));
  });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('[data-nav-group]')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      closeMobile();
    }
  });

  // Langue : cookie + ?lang= pour conserver la langue pendant la navigation
  document.querySelectorAll('[data-lang-switch]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const lang = el.getAttribute('data-lang-switch');
      // Site statique : c'est localStorage (lu par clientLang) qui fait foi,
      // le cookie n'était lu par personne.
      try {
        localStorage.setItem('ah-lang', lang!);
      } catch {
        /* stockage indisponible : ?lang= suffit pour la page courante */
      }
      const url = new URL(window.location.href);
      url.searchParams.set('lang', lang!);
      window.location.href = url.toString();
    });
  });
</script>
