{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "_comment": "supabase/functions tourne sous Deno (globale `Deno`, imports npm:) : hors périmètre du typage Astro.",
  "exclude": ["dist", "supabase/functions"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite-plugin-pwa/client", "node"]
  }
}
